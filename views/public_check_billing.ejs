<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= settings.company_header || 'Portal ISP' %> | Cek Tagihan Pelanggan</title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#317fe4">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary-teal: #317fe4;
      --primary-dark: #1f5eb1;
      --primary-light: #eff6ff;
      --primary-border: #bfdbfe;
      --accent-green: #10b981;
      --bg-right: #f4f8fb;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      background-color: var(--bg-right);
      color: var(--text-dark);
    }

    .split-container {
      min-height: 100vh;
      display: flex;
      width: 100%;
    }

    /* ── LEFT PANEL (DARK TEAL BRAND SIDE - DESKTOP VIEW) ── */
    .left-panel {
      flex: 1;
      background: linear-gradient(145deg, #317fe4 0%, #1a4f9c 100%);
      color: #ffffff;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .left-panel::before {
      content: '';
      position: absolute;
      top: -10%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(49, 127, 228, 0) 70%);
      pointer-events: none;
    }

    .brand-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-header-left img,
    img[alt="Logo"] {
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      height: 52px !important;
      max-width: 100% !important;
      width: auto !important;
      object-fit: contain !important;
      display: block;
    }

    .hero-welcome-box {
      max-width: 500px;
      margin: auto 0;
    }

    .hero-welcome-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      margin-bottom: 18px;
      color: #ffffff;
      letter-spacing: -0.8px;
    }

    .hero-welcome-desc {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.6;
      margin-bottom: 0;
    }

    /* Testimonial Widget Box */
    .testimonial-card {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      padding: 24px;
      max-width: 480px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }

    .testimonial-headline {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .testimonial-quote {
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.55;
      font-style: italic;
      margin-bottom: 16px;
    }

    .testimonial-user {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .user-avatar-pill {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.22);
      color: #ffffff;
      font-weight: 800;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .user-info-name {
      font-size: 0.88rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
    }

    .user-info-role {
      font-size: 0.76rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .rating-stars {
      color: #fbbf24;
      font-size: 0.9rem;
      display: flex;
      gap: 3px;
    }

    /* ── RIGHT PANEL (LIGHT LOGIN SIDE) ── */
    .right-panel {
      flex: 1;
      background-color: var(--bg-right);
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .login-form-wrapper {
      width: 100%;
      max-width: 580px;
    }

    /* Top Progress Pill */
    .top-progress-pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-bottom: 24px;
    }

    .progress-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--primary-teal);
      transition: all 0.3s ease;
    }

    .progress-dot.small-dot {
      width: 7px;
      height: 7px;
    }

    .progress-dot.active {
      background: var(--primary-teal);
      box-shadow: 0 0 0 3px rgba(49, 127, 228, 0.2);
      animation: pulseGreenDot 2s infinite ease-in-out;
    }

    .progress-dot.inactive {
      background: #cbd5e1;
      opacity: 0.6;
    }

    .progress-bar-segment {
      height: 4px;
      border-radius: 10px;
      transition: all 0.3s ease;
    }

    .progress-bar-segment.active {
      width: 36px;
      background: linear-gradient(90deg, #317fe4 0%, #2563eb 100%);
      position: relative;
      overflow: hidden;
    }

    .progress-bar-segment.active::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
      animation: shimmerPill 2.5s infinite;
    }

    .progress-bar-segment.inactive {
      width: 24px;
      background: #cbd5e1;
      opacity: 0.5;
    }

    @keyframes pulseGreenDot {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(49, 127, 228, 0.4); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(49, 127, 228, 0); }
    }

    @keyframes shimmerPill {
      0% { left: -100%; }
      60%, 100% { left: 100%; }
    }

    .login-main-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--primary-teal);
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    .login-main-subtitle {
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    /* Form Inputs */
    .field-label {
      font-size: 0.86rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 8px;
      display: block;
    }

    .custom-input-box {
      width: 100%;
      height: 52px;
      background: #ffffff;
      border: 1.5px solid var(--border-color);
      border-radius: 14px;
      padding: 0 18px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-dark);
      transition: all 0.25s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }

    .custom-input-box:focus {
      outline: none;
      border-color: var(--primary-teal);
      box-shadow: 0 0 0 0.25rem rgba(49, 127, 228, 0.15);
      background: #ffffff;
    }

    .btn-masuk-primary {
      width: 100%;
      height: 52px;
      background: var(--primary-teal);
      border: none;
      border-radius: 14px;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(49, 127, 228, 0.25);
      margin-top: 20px;
    }

    .btn-masuk-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(49, 127, 228, 0.38);
      color: #ffffff;
    }

    /* Table & Payment Cards */
    .custom-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .custom-table th {
      background: #ffffff;
      padding: 12px 16px;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #64748b;
      border-bottom: 1px solid var(--border-color);
    }

    .custom-table td {
      padding: 12px 16px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      font-size: 0.9rem;
    }

    .pay-methods-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .pm-radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .pay-method-card {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px;
      background: #ffffff;
      border: 1.5px solid var(--border-color);
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .pay-method-card:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      transform: translateY(-2px);
    }

    .pm-radio:checked + .pay-method-card {
      background: var(--primary-light);
      border-color: var(--primary-teal);
      box-shadow: 0 4px 16px rgba(49, 127, 228, 0.15);
    }

    .pay-icon-box {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: var(--primary-teal);
      flex-shrink: 0;
    }

    .pay-name {
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--text-dark);
      line-height: 1.2;
    }

    .pay-fee-chip {
      font-size: 0.7rem;
      color: #64748b;
      font-weight: 700;
    }

    /* Quick Action Tools Bar */
    .quick-access-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 28px;
    }

    .quick-access-btn {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 12px 8px;
      text-decoration: none !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-align: center;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .quick-access-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      transform: translateY(-2px);
    }

    .quick-access-icon {
      font-size: 1.25rem;
    }

    .quick-access-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .register-footer-link {
      text-align: center;
      margin-top: 24px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .register-footer-link a {
      color: var(--primary-teal);
      font-weight: 800;
      text-decoration: none;
    }

    .register-footer-link a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .left-panel {
        display: none;
      }
      .right-panel {
        padding: 36px 18px;
        min-height: 100vh;
      }
      .login-main-title {
        font-size: 1.85rem;
      }
      .quick-access-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .pay-methods-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>

  <div class="split-container">

    <!-- ── LEFT PANEL (BRAND SIDE - DESKTOP VIEW) ── -->
    <div class="left-panel">

      <!-- Top Header Brand (Clickable to /customer/home) -->
      <a href="/customer/home" class="brand-header-left text-decoration-none">
        <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
             alt="Logo" style="height: 50px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
      </a>

      <!-- Hero Welcome Message -->
      <div class="hero-welcome-box">
        <h1 class="hero-welcome-title">Cek Tagihan.</h1>
        <p class="hero-welcome-desc">
          Periksa rincian tagihan bulanan internet Anda dan lakukan pembayaran instan secara mudah, aman, dan tanpa hambatan.
        </p>
      </div>

      <!-- Testimonial / Quality Guarantee Card -->
      <div class="testimonial-card">
        <div class="testimonial-headline">Guaranteed Quality & Uptime</div>
        <div class="testimonial-quote">
          "Koneksi internet fiber optic super cepat, stabil 24/7 tanpa FUP. Layanan pembayaran tagihan & bantuan CS terintegrasi sangat memudahkan."
        </div>
        <div class="testimonial-user">
          <div class="d-flex align-items-center gap-3">
            <div class="user-avatar-pill">PS</div>
            <div>
              <div class="user-info-name">Pelanggan Setia</div>
              <div class="user-info-role"><%= settings.company_header %> Customer</div>
            </div>
          </div>
          <div class="rating-stars">
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
          </div>
        </div>
      </div>

    </div>

    <!-- ── RIGHT PANEL (LIGHT CONTENT SIDE) ── -->
    <div class="right-panel">

      <!-- Main Form Wrapper -->
      <div class="login-form-wrapper">

        <!-- Centered Logo (Mobile View Only) -->
        <div class="text-center mb-3 d-lg-none">
          <a href="/customer/home" class="d-inline-flex align-items-center justify-content-center text-decoration-none">
            <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
                 alt="Logo" style="height: 48px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
          </a>
        </div>

        <!-- Progress Dots Pill with Animation -->
        <div class="top-progress-pill justify-content-center">
          <div class="progress-dot active"></div>
          <div class="progress-bar-segment active"></div>
          <div class="progress-dot active small-dot"></div>
          <div class="progress-bar-segment inactive"></div>
          <div class="progress-dot inactive small-dot"></div>
        </div>

        <!-- Form Title Header -->
        <h2 class="login-main-title">Cek & Bayar Tagihan</h2>
        <p class="login-main-subtitle">
          Masukkan ID Pelanggan, Nama, Nomor WhatsApp, atau Username PPPoE Anda
        </p>

        <!-- Search Form -->
        <form method="GET" action="/customer/check-billing" class="mb-4">
          <label for="q" class="field-label">Kata Kunci Pencarian Akun</label>
          <div class="input-group">
            <input type="text" class="custom-input-box" id="q" name="q" value="<%= query || '' %>" 
                   placeholder="Contoh: ID12345, Budi, atau 08123456789" required autofocus>
          </div>

          <button type="submit" class="btn-masuk-primary">
            <i class="bi bi-search me-1"></i>
            <span>Cek Tagihan Pelanggan</span>
          </button>
        </form>

        <!-- Alerts -->
        <% if (error) { %>
          <div class="alert alert-danger py-2.5 px-3 mb-3 rounded-3 small fw-semibold text-center">
            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
          </div>
        <% } %>

        <% if (info) { %>
          <div class="alert alert-success py-2.5 px-3 mb-3 rounded-3 small fw-semibold text-center">
            <i class="bi bi-check-circle me-2"></i> <%= info %>
          </div>
        <% } %>

        <% if (query && !customer && (!matches || matches.length === 0)) { %>
          <div class="alert alert-warning py-3 px-4 mb-4 rounded-4 text-center">
            <i class="bi bi-search fs-3 text-warning mb-2 d-block"></i>
            <h6 class="fw-bold text-dark mb-1">Pelanggan Tidak Ditemukan</h6>
            <small class="text-muted">Pastikan kata kunci ID, Nama, atau Nomor WhatsApp yang Anda masukkan sudah benar.</small>
          </div>
        <% } %>

        <!-- Multiple Search Matches Table -->
        <% if (!customer && matches && matches.length > 0) { %>
          <div class="mb-3">
            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-list-stars me-1 text-primary"></i> Hasil Pencarian Akun</h6>
            <small class="text-muted">Pilih akun Anda dari daftar di bawah untuk melihat rincian tagihan:</small>
          </div>
          <div class="table-responsive rounded-4 border bg-white mb-4">
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Nama Pelanggan</th>
                  <th class="text-end">Belum Bayar</th>
                  <th class="text-end">Total Tagihan</th>
                  <th class="text-end">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% matches.forEach(m => { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-dark"><%= m.customer_name %></div>
                      <div class="small text-muted">
                        ID: <%= m.customer_id %><% if (m.customer_phone) { %> • WA: <%= m.customer_phone %><% } %>
                      </div>
                    </td>
                    <td class="text-end fw-bold text-danger"><%= Number(m.unpaid_count || 0) %> Tagihan</td>
                    <td class="text-end fw-extrabold text-dark">Rp <%= Number(m.total_amount || 0).toLocaleString('id-ID') %></td>
                    <td class="text-end">
                      <a class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold text-decoration-none" href="/customer/check-billing?q=<%= encodeURIComponent(String(m.customer_id)) %>">
                        Pilih <i class="bi bi-arrow-right"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <!-- Single Customer Details & Invoices -->
        <% if (customer) { %>
          <div class="p-3 mb-4 rounded-4 border bg-white shadow-sm">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div>
                <h5 class="fw-extrabold text-dark mb-1"><%= customer.name %></h5>
                <div class="small text-muted">
                  <strong>ID:</strong> <%= customer.id %>
                  <% if (customer.phone) { %> • <strong>WA:</strong> <%= customer.phone %><% } %>
                  <% if (customer.package_name) { %> • <strong>Paket:</strong> <%= customer.package_name %><% } %>
                </div>
              </div>
              <div>
                <% const unpaidCount = unpaidInvoices ? unpaidInvoices.length : 0; %>
                <% if (unpaidCount > 0) { %>
                  <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1.5 fw-bold">
                    <i class="bi bi-exclamation-circle me-1"></i> <%= unpaidCount %> Belum Bayar
                  </span>
                <% } else { %>
                  <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1.5 fw-bold">
                    <i class="bi bi-check-circle me-1"></i> Semua Lunas
                  </span>
                <% } %>
              </div>
            </div>
          </div>

          <% const monthNames = ['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>

          <% if (!unpaidInvoices || unpaidInvoices.length === 0) { %>
            <div class="alert alert-success py-3 px-4 rounded-4 border-success border-opacity-25 text-center mb-4">
              <i class="bi bi-check-circle-fill fs-2 text-success mb-2 d-block"></i>
              <h6 class="fw-bold text-dark mb-1">Tidak Ada Tagihan Tertunggak</h6>
              <small class="text-muted">Terima kasih! Seluruh tagihan internet Anda telah lunas.</small>
            </div>
          <% } else { %>
            
            <div class="mb-2">
              <h6 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history me-1 text-danger"></i> Tagihan Belum Dibayar</h6>
              <small class="text-muted">Pilih tagihan yang ingin dibayar:</small>
            </div>

            <div class="table-responsive rounded-4 border bg-white mb-4">
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Periode Tagihan</th>
                    <th class="text-end">Nominal Tagihan</th>
                    <th class="text-end" style="width: 80px">Pilih</th>
                  </tr>
                </thead>
                <tbody>
                  <% unpaidInvoices.forEach((inv, idx) => { %>
                    <tr>
                      <td>
                        <div class="fw-bold text-dark"><%= monthNames[Number(inv.period_month)] %> <%= inv.period_year %></div>
                        <div class="small text-muted">No. Invoice: INV-<%= inv.id %></div>
                      </td>
                      <td class="text-end fw-extrabold text-dark fs-6">Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></td>
                      <td class="text-end">
                        <input
                          class="form-check-input inv-radio"
                          type="radio"
                          name="inv_select"
                          value="<%= inv.id %>"
                          data-inv-id="<%= inv.id %>"
                          data-amount="<%= Number(inv.amount || 0) %>"
                          data-token="<%= (invoiceTokens && invoiceTokens[String(inv.id)]) ? invoiceTokens[String(inv.id)] : '' %>"
                          <%= idx === 0 ? 'checked' : '' %>
                          <%= idx === 0 ? 'required' : '' %>
                          style="cursor: pointer; width: 20px; height: 20px;"
                        >
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <!-- Payment Methods Form Section -->
            <div class="pt-3 border-top">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-credit-card-2-front me-1 text-primary"></i> Pilih Metode Pembayaran</h6>
                <div class="small text-muted fw-bold">
                  <span id="pay_inv_text"></span>
                  <span id="pay_amount_text" class="text-primary fs-6 fw-extrabold"></span>
                </div>
              </div>

              <form id="payForm" method="POST" action="/customer/public/payment/create/0" class="d-grid gap-3">
                <input type="hidden" name="token" id="pay_token" value="">
                <input type="hidden" name="method" id="pay_method" value="">

                <% const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0'); %>
                <% if (hasStaticQris || (paymentChannels && paymentChannels.length > 0)) { %>
                  <div class="pay-methods-grid">
                    <% if (hasStaticQris) { %>
                      <label style="cursor: pointer">
                        <input
                          class="pm-radio"
                          type="radio"
                          name="payment_method"
                          value="QRIS_STATIC"
                          data-code="QRIS_STATIC"
                          checked
                          required
                        >
                        <div class="pay-method-card">
                          <div class="pay-icon-box"><i class="bi bi-qr-code-scan"></i></div>
                          <div>
                            <div class="pay-name">QRIS Statis</div>
                            <div class="pay-fee-chip">Scan E-Wallet / Bank</div>
                          </div>
                        </div>
                      </label>
                    <% } %>
                    <% paymentChannels.forEach((ch, idx) => {
                      const code = String(ch.code || '').toUpperCase();
                      const name = String(ch.name || code);
                      const iconUrl = String(ch.icon_url || '');
                    %>
                      <label style="cursor: pointer">
                        <input
                          class="pm-radio"
                          type="radio"
                          name="payment_method"
                          value="<%= code %>"
                          data-code="<%= code %>"
                          <%= (!hasStaticQris && idx === 0) ? 'checked' : '' %>
                          required
                        >
                        <div class="pay-method-card">
                          <div class="pay-icon-box">
                            <% if (iconUrl) { %>
                              <img src="<%= iconUrl %>" alt="<%= name %>" style="width: 100%; height: 100%; object-fit: contain; padding: 4px;">
                            <% } else { %>
                              <i class="bi bi-credit-card"></i>
                            <% } %>
                          </div>
                          <div>
                            <div class="pay-name"><%= name %></div>
                            <div class="pay-fee-chip">Online Instant</div>
                          </div>
                        </div>
                      </label>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="alert alert-warning py-2.5 px-3 rounded-3 small fw-semibold">
                    <i class="bi bi-exclamation-triangle me-2"></i>Metode pembayaran online sedang tidak tersedia saat ini.
                  </div>
                <% } %>

                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" value="1" id="tos_pay" name="tos" required style="cursor: pointer;">
                  <label class="form-check-label small text-muted" for="tos_pay" style="cursor: pointer;">
                    Saya setuju dengan <a href="/customer/tos" target="_blank" rel="noopener" class="fw-bold text-decoration-none" style="color: var(--primary-teal);">Syarat & Ketentuan Pembayaran</a>
                  </label>
                </div>

                <button id="payBtn" class="btn-masuk-primary mt-2" type="submit" disabled>
                  <span>Proses Pembayaran</span>
                  <i class="bi bi-arrow-right fs-5"></i>
                </button>
              </form>
            </div>

            <script>
              (function () {
                const invRadios = Array.from(document.querySelectorAll('.inv-radio'));
                const payMethodRadios = Array.from(document.querySelectorAll('input[name="payment_method"]'));
                const payForm = document.getElementById('payForm');
                const payToken = document.getElementById('pay_token');
                const payMethod = document.getElementById('pay_method');
                const payBtn = document.getElementById('payBtn');
                const invText = document.getElementById('pay_inv_text');
                const amtText = document.getElementById('pay_amount_text');

                function updatePaymentForm() {
                  if (!payForm || !payToken || !payMethod || !payBtn) return;
                  
                  const selectedInv = invRadios.find(r => r.checked);
                  const selectedMethod = payMethodRadios.find(r => r.checked);
                  
                  if (!selectedInv) {
                    payBtn.disabled = true;
                    return;
                  }

                  const invId = String(selectedInv.dataset.invId || selectedInv.value || '').trim();
                  const token = String(selectedInv.dataset.token || '').trim();
                  const amount = Number(selectedInv.dataset.amount || 0) || 0;
                  const methodCode = selectedMethod ? String(selectedMethod.dataset.code || selectedMethod.value || '').trim() : '';

                  payForm.action = `/customer/public/payment/create/${encodeURIComponent(invId)}`;
                  payToken.value = token;
                  payMethod.value = methodCode;
                  
                  if (invText) invText.textContent = invId ? `INV-${invId} • ` : '';
                  if (amtText) amtText.textContent = amount ? `Rp ${amount.toLocaleString('id-ID')}` : '';
                  
                  payBtn.disabled = !invId || !token || !methodCode;
                }

                invRadios.forEach(r => r.addEventListener('change', updatePaymentForm));
                payMethodRadios.forEach(r => r.addEventListener('change', updatePaymentForm));
                
                updatePaymentForm();
              })();
            </script>
          <% } %>

          <!-- Paid History Table -->
          <% const paidInvoices = (invoices || []).filter(i => i.status === 'paid'); %>
          <% if (paidInvoices.length > 0) { %>
            <div class="mt-4 pt-3 border-top">
              <h6 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history me-1 text-success"></i> Riwayat Tagihan Lunas</h6>
              <small class="text-muted">Menampilkan <%= Math.min(paidInvoices.length, 10) %> data pembayaran terbaru:</small>
              <div class="table-responsive rounded-4 border bg-white mt-2">
                <table class="custom-table">
                  <thead>
                    <tr>
                      <th>Periode</th>
                      <th class="text-end">Nominal</th>
                      <th class="text-end">Tanggal Lunas</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% paidInvoices.slice(0, 10).forEach(inv => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-dark"><%= monthNames[Number(inv.period_month)] %> <%= inv.period_year %></div>
                          <div class="small text-muted">INV-<%= inv.id %></div>
                        </td>
                        <td class="text-end fw-extrabold text-success">Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></td>
                        <td class="text-end small text-muted"><%= inv.paid_at ? new Date(inv.paid_at).toLocaleString('id-ID') : '-' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>
        <% } %>

        <!-- Quick Action Tools Grid -->
        <div class="quick-access-grid">
          <a href="/customer/login" class="quick-access-btn">
            <i class="bi bi-box-arrow-in-right text-primary quick-access-icon"></i>
            <span class="quick-access-label">Login Portal</span>
          </a>

          <a href="/customer/voucher" class="quick-access-btn">
            <i class="bi bi-ticket-perforated text-warning quick-access-icon"></i>
            <span class="quick-access-label">Beli Voucher</span>
          </a>

          <a href="/customer/register" class="quick-access-btn">
            <i class="bi bi-person-plus text-success quick-access-icon"></i>
            <span class="quick-access-label">Pasang Baru</span>
          </a>

          <% 
            let waClean = String(settings.company_phone || '').replace(/\D/g, '');
            if (waClean.startsWith('0')) waClean = '62' + waClean.slice(1);
          %>
          <a href="<%= waClean ? 'https://wa.me/' + waClean : '#' %>" target="_blank" rel="noopener" class="quick-access-btn">
            <i class="bi bi-whatsapp text-success quick-access-icon"></i>
            <span class="quick-access-label">Bantuan CS</span>
          </a>
        </div>

        <!-- Register Link -->
        <div class="register-footer-link">
          Sudah memiliki akun? <a href="/customer/login">Masuk ke Portal</a> • <a href="/customer/home">Beranda Utama</a>
        </div>

      </div>

    </div>

  </div>

</body>

</html>

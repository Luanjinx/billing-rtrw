<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= (typeof company !== 'undefined' && company) ? company : 'Portal ISP' %> | Layanan Terisolir</title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#ef4444">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary-teal: #317fe4;
      --primary-dark: #1f5eb1;
      --primary-light: #eff6ff;
      --primary-border: #bfdbfe;
      --accent-danger: #ef4444;
      --accent-green: #10b981;
      --bg-right: #f4f8fb;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      min-height: 100%;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      background-color: var(--bg-right);
      color: var(--text-dark);
    }

    .split-container {
      min-height: 100vh;
      display: flex;
      width: 100%;
    }

    /* ── LEFT PANEL (DARK BRAND SIDE WITH DANGER RADIAL HIGHLIGHT) ── */
    .left-panel {
      flex: 1;
      background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
      color: #ffffff;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .left-panel::before {
      content: '';
      position: absolute;
      top: -10%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(239, 68, 68, 0.18) 0%, rgba(15, 23, 42, 0) 70%);
      pointer-events: none;
    }

    .brand-header-left {
      display: inline-flex;
      align-items: center;
    }

    .brand-header-left img,
    img[alt="Logo"] {
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      height: 52px !important;
      max-width: 100% !important;
      width: auto !important;
      object-fit: contain !important;
      display: block;
    }

    .hero-welcome-box {
      max-width: 500px;
      margin: auto 0;
    }

    .hero-welcome-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      margin-bottom: 18px;
      color: #ffffff;
      letter-spacing: -0.8px;
    }

    .hero-welcome-desc {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.6;
      margin-bottom: 0;
    }

    /* Info / Status Box in Left Panel */
    .left-info-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 20px;
      padding: 24px;
      max-width: 480px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .left-info-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .left-info-quote {
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.55;
      margin-bottom: 0;
    }

    /* ── RIGHT PANEL (LIGHT CONTENT SIDE) ── */
    .right-panel {
      flex: 1;
      background-color: var(--bg-right);
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .login-form-wrapper {
      width: 100%;
      max-width: 520px;
    }

    /* Top Progress Pill */
    .top-progress-pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-bottom: 24px;
    }

    .progress-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent-danger);
      transition: all 0.3s ease;
    }

    .progress-dot.small-dot {
      width: 7px;
      height: 7px;
    }

    .progress-dot.active {
      background: var(--accent-danger);
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
      animation: pulseDangerDot 2s infinite ease-in-out;
    }

    .progress-dot.success {
      background: var(--accent-green);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
      animation: pulseGreenDot 2s infinite ease-in-out;
    }

    .progress-bar-segment {
      height: 4px;
      border-radius: 10px;
      transition: all 0.3s ease;
    }

    .progress-bar-segment.active-danger {
      width: 36px;
      background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
      position: relative;
      overflow: hidden;
    }

    .progress-bar-segment.active-success {
      width: 36px;
      background: linear-gradient(90deg, #10b981 0%, #059669 100%);
      position: relative;
      overflow: hidden;
    }

    .progress-bar-segment.active-danger::after,
    .progress-bar-segment.active-success::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
      animation: shimmerPill 2.5s infinite;
    }

    .progress-bar-segment.inactive {
      width: 24px;
      background: #cbd5e1;
      opacity: 0.5;
    }

    @keyframes pulseDangerDot {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    }

    @keyframes pulseGreenDot {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    }

    @keyframes shimmerPill {
      0% { left: -100%; }
      60%, 100% { left: 100%; }
    }

    .login-main-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    .login-main-subtitle {
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    /* Cards & Info Grid */
    .info-card-item {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .info-card-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: var(--primary-light);
      color: var(--primary-teal);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .info-card-label {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }

    .info-card-value {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text-dark);
    }

    /* Action Buttons */
    .btn-action-primary {
      width: 100%;
      height: 52px;
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      border: none;
      border-radius: 14px;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(239, 68, 68, 0.28);
      text-decoration: none !important;
    }

    .btn-action-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(239, 68, 68, 0.4);
      color: #ffffff;
    }

    .btn-action-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .btn-action-success {
      width: 100%;
      height: 52px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      border-radius: 14px;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.28);
      text-decoration: none !important;
    }

    .btn-action-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(16, 185, 129, 0.4);
      color: #ffffff;
    }

    .btn-action-wa {
      width: 100%;
      height: 50px;
      background: #25d366;
      border: none;
      border-radius: 14px;
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(37, 211, 102, 0.25);
      text-decoration: none !important;
    }

    .btn-action-wa:hover {
      filter: brightness(1.05);
      transform: translateY(-2px);
      color: #ffffff;
    }

    .btn-outline-action {
      background: #ffffff;
      border: 1.5px solid var(--border-color);
      border-radius: 12px;
      padding: 10px 16px;
      font-size: 0.88rem;
      font-weight: 700;
      color: #334155;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none !important;
    }

    .btn-outline-action:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      color: var(--primary-teal);
    }

    /* Quick Action Tools Bar */
    .quick-access-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 28px;
    }

    .quick-access-btn {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 12px 8px;
      text-decoration: none !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-align: center;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .quick-access-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      transform: translateY(-2px);
    }

    .quick-access-icon {
      font-size: 1.25rem;
    }

    .quick-access-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .register-footer-link {
      text-align: center;
      margin-top: 24px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .spinner {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(16, 185, 129, 0.3);
      border-top-color: #10b981;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .left-panel {
        display: none;
      }
      .right-panel {
        padding: 36px 18px;
        min-height: 100vh;
      }
      .login-main-title {
        font-size: 1.85rem;
      }
      .quick-access-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>

  <div class="split-container">

    <!-- ── LEFT PANEL (DARK BRAND SIDE WITH DANGER GLOW - DESKTOP VIEW) ── -->
    <div class="left-panel">

      <!-- Top Header Brand (Clickable to /customer/home) -->
      <a href="/customer/home" class="brand-header-left text-decoration-none">
        <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
             alt="Logo" style="height: 50px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
      </a>

      <!-- Hero Welcome Message -->
      <div class="hero-welcome-box">
        <h1 class="hero-welcome-title">Akses Terisolir.</h1>
        <p class="hero-welcome-desc">
          Layanan internet Anda sementara dinonaktifkan karena tagihan belum diselesaikan. Bayar sekarang untuk otomatis mengaktifkan kembali koneksi internet Anda.
        </p>
      </div>

      <!-- Left Info Box -->
      <div class="left-info-card">
        <div class="left-info-badge">
          <i class="bi bi-shield-lock-fill"></i> Status Layanan: Terisolir
        </div>
        <p class="left-info-quote">
          Setelah pembayaran terkonfirmasi oleh sistem, koneksi internet Anda akan otomatis aktif kembali dalam beberapa detik tanpa perlu restart router.
        </p>
      </div>

    </div>

    <!-- ── RIGHT PANEL (LIGHT CONTENT SIDE) ── -->
    <div class="right-panel">

      <!-- Main Form Wrapper -->
      <div class="login-form-wrapper">

        <!-- Centered Logo (Mobile View Only) -->
        <div class="text-center mb-3 d-lg-none">
          <a href="/customer/home" class="d-inline-flex align-items-center justify-content-center text-decoration-none">
            <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
                 alt="Logo" style="height: 48px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
          </a>
        </div>

        <!-- ── CASE 1: CUSTOMER NOT IDENTIFIED ── -->
        <% if (!customer) { %>
          
          <!-- Progress Dots Pill -->
          <div class="top-progress-pill justify-content-center">
            <div class="progress-dot active"></div>
            <div class="progress-bar-segment active-danger"></div>
            <div class="progress-dot active small-dot"></div>
            <div class="progress-bar-segment active-danger"></div>
            <div class="progress-dot active small-dot"></div>
          </div>

          <!-- Header Title -->
          <h2 class="login-main-title text-danger"><i class="bi bi-shield-lock me-1"></i> Akses Terbatas</h2>
          <p class="login-main-subtitle">
            Layanan internet Anda sementara dinonaktifkan. Silakan lunasi tagihan Anda atau hubungi admin.
          </p>

          <!-- Info Cards Grid -->
          <div class="d-grid gap-2 mb-4">
            <div class="info-card-item">
              <div class="info-card-icon"><i class="bi bi-building"></i></div>
              <div>
                <div class="info-card-label">Penyedia Layanan</div>
                <div class="info-card-value"><%= (typeof company !== 'undefined' && company) ? company : 'ISP Network' %></div>
              </div>
            </div>

            <% if (typeof adminPhone !== 'undefined' && adminPhone) { %>
              <div class="info-card-item">
                <div class="info-card-icon"><i class="bi bi-whatsapp text-success"></i></div>
                <div>
                  <div class="info-card-label">Pusat Bantuan WhatsApp</div>
                  <div class="info-card-value"><%= adminPhone %></div>
                </div>
              </div>
            <% } %>

            <% if (typeof address !== 'undefined' && address) { %>
              <div class="info-card-item">
                <div class="info-card-icon"><i class="bi bi-geo-alt text-danger"></i></div>
                <div>
                  <div class="info-card-label">Lokasi Kantor</div>
                  <div class="info-card-value"><%= address %></div>
                </div>
              </div>
            <% } %>
          </div>

          <!-- WhatsApp Admin CTA -->
          <% if (typeof adminPhone !== 'undefined' && adminPhone) { 
            let waClean = String(adminPhone).replace(/\D/g, '');
            if (waClean.startsWith('0')) waClean = '62' + waClean.slice(1);
          %>
            <a href="https://wa.me/<%= waClean %>?text=Halo%20Admin%20<%= encodeURIComponent(company || '') %>,%20layanan%20internet%20saya%20terisolir.%20Mohon%20bantuannya." 
               target="_blank" rel="noopener" class="btn-action-wa mb-3">
              <i class="bi bi-whatsapp fs-5 me-1"></i> Hubungi Admin via WhatsApp
            </a>
          <% } %>

          <div class="row g-2 mb-4">
            <div class="col-6">
              <a href="/customer/check-billing" class="btn-outline-action w-100">
                <i class="bi bi-receipt me-1"></i> Cek Tagihan
              </a>
            </div>
            <div class="col-6">
              <a href="/customer/login" class="btn-outline-action w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Login Akun
              </a>
            </div>
          </div>

        <% } %>

        <!-- ── CASE 2: CUSTOMER FOUND BUT NO UNPAID INVOICES (PAID) ── -->
        <% if (customer && !hasUnpaidInvoices) { %>
          
          <!-- Progress Dots Pill -->
          <div class="top-progress-pill justify-content-center">
            <div class="progress-dot success"></div>
            <div class="progress-bar-segment active-success"></div>
            <div class="progress-dot success small-dot"></div>
            <div class="progress-bar-segment active-success"></div>
            <div class="progress-dot success small-dot"></div>
          </div>

          <!-- Header Title -->
          <h2 class="login-main-title text-success"><i class="bi bi-check-circle me-1"></i> Tagihan Lunas</h2>
          <p class="login-main-subtitle">
            Terima kasih! Semua tagihan Anda telah dibayar. Layanan internet sedang dalam proses pengaktifan kembali.
          </p>

          <!-- Customer Info -->
          <div class="p-3 mb-4 rounded-4 border bg-white shadow-sm">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div>
                <h5 class="fw-extrabold text-dark mb-1"><%= customer.name %></h5>
                <div class="small text-muted">
                  <strong>ID:</strong> <%= customer.id %>
                  <% if (customer.phone) { %> • <strong>WA:</strong> <%= customer.phone %><% } %>
                </div>
              </div>
              <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1.5 fw-bold">
                <i class="bi bi-check-lg me-1"></i> Status Lunas
              </span>
            </div>
          </div>

          <div class="p-3 mb-4 rounded-4 text-center border-0 shadow-sm" style="background: #ecfdf5; color: #065f46;">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
              <div class="spinner"></div>
              <strong class="small">Koneksi sedang direfresh otomatis...</strong>
            </div>
            <div class="small text-muted">Jika halaman tidak memuat ulang otomatis dalam 30 detik, silakan klik tombol di bawah.</div>
          </div>

          <form action="/customer/reconnect" method="POST" class="mb-4">
            <button type="submit" class="btn-action-success">
              <i class="bi bi-arrow-repeat fs-5 me-1"></i>
              <span>Re-Connect & Refresh Internet Sekarang</span>
            </button>
          </form>

          <script>
            let checkCount = 0;
            function checkStatus() {
              fetch('/isolated/status', { method: 'GET' })
                .then(r => r.json())
                .then(d => {
                  if (d.status === 'active' || d.unpaid_count === 0) {
                    setTimeout(() => window.location.href = '/customer/dashboard', 1000);
                  } else if (++checkCount < 10) {
                    setTimeout(checkStatus, 3000);
                  }
                })
                .catch(() => {
                  if (++checkCount < 10) setTimeout(checkStatus, 3000);
                });
            }
            setTimeout(checkStatus, 3000);
          </script>

        <% } %>

        <!-- ── CASE 3: CUSTOMER HAS UNPAID INVOICES ── -->
        <% if (customer && hasUnpaidInvoices) { %>
          
          <!-- Progress Dots Pill -->
          <div class="top-progress-pill justify-content-center">
            <div class="progress-dot active"></div>
            <div class="progress-bar-segment active-danger"></div>
            <div class="progress-dot active small-dot"></div>
            <div class="progress-bar-segment active-danger"></div>
            <div class="progress-dot active small-dot"></div>
          </div>

          <!-- Header Title -->
          <h2 class="login-main-title text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Layanan Terisolir</h2>
          <p class="login-main-subtitle">
            Halo <strong><%= customer.name %></strong>, mohon lunasi tagihan di bawah ini untuk langsung mengaktifkan kembali layanan internet Anda.
          </p>

          <!-- Danger Banner -->
          <div class="p-3 mb-4 rounded-4 border border-danger border-opacity-25" style="background: #fef2f2; color: #991b1b;">
            <div class="d-flex align-items-center gap-2 small fw-bold">
              <i class="bi bi-exclamation-circle-fill text-danger fs-5"></i>
              <span>Koneksi terisolir karena terdapat <%= invoices.length %> tagihan belum dibayar.</span>
            </div>
          </div>

          <!-- Unpaid Invoices List -->
          <div class="mb-2 fw-bold text-dark small"><i class="bi bi-receipt me-1 text-danger"></i> Rincian Tagihan Belum Dibayar:</div>
          <div class="d-grid gap-2 mb-4">
            <% invoices.forEach((inv) => { %>
              <div class="p-3 rounded-4 border bg-white d-flex align-items-center justify-content-between">
                <div>
                  <div class="fw-extrabold text-dark" style="font-size: 0.95rem;">
                    <%= new Date(inv.period_year, inv.period_month - 1).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %>
                  </div>
                  <div class="small text-muted">Invoice No. INV-<%= inv.id %></div>
                </div>
                <div class="text-end fw-extrabold text-danger fs-6">
                  Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %>
                </div>
              </div>
            <% }); %>
          </div>

          <!-- Payment Form CTA -->
          <form id="paymentForm" class="mb-4">
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="tosCheckbox" name="accept_tos" value="1" required style="cursor: pointer;">
              <label class="form-check-label small fw-semibold text-muted" for="tosCheckbox" style="cursor: pointer;">
                Saya setuju dengan syarat & ketentuan pembayaran
              </label>
            </div>

            <button type="button" class="btn-action-primary" id="submitBtn" disabled onclick="goToPayment()">
              <span>BAYAR SEKARANG</span>
              <i class="bi bi-arrow-right fs-5 me-1"></i>
            </button>
          </form>

          <script>
            const tosCheckbox = document.getElementById('tosCheckbox');
            const submitBtn = document.getElementById('submitBtn');
            if (tosCheckbox && submitBtn) {
              tosCheckbox.addEventListener('change', () => {
                submitBtn.disabled = !tosCheckbox.checked;
              });
            }

            function goToPayment() {
              const invoiceId = <%= (invoices && invoices.length > 0) ? invoices[0].id : 0 %>;
              const publicToken = '<%= (invoices && invoices.length > 0 && invoices[0].publicToken) ? invoices[0].publicToken : "" %>';
              window.location.href = `/customer/payment/create/${invoiceId}?t=${encodeURIComponent(publicToken)}`;
            }

            // Polling status
            let pollCount = 0;
            function pollStatus() {
              const invoiceId = <%= (invoices && invoices.length > 0) ? invoices[0].id : 0 %>;
              const token = '<%= (invoices && invoices.length > 0 && invoices[0].publicToken) ? invoices[0].publicToken : "" %>';
              if (!invoiceId) return;
              const url = `/customer/payment/status/${invoiceId}${token ? '?t=' + encodeURIComponent(token) : ''}`;
              
              fetch(url, { method: 'GET' })
                .then(r => r.json())
                .then(d => {
                  if (d.status === 'paid' || d.paid_at) {
                    window.location.href = '/customer/dashboard';
                  } else if (++pollCount < 20) {
                    setTimeout(pollStatus, 3000);
                  }
                })
                .catch(() => {
                  if (++pollCount < 20) setTimeout(pollStatus, 3000);
                });
            }
            setTimeout(pollStatus, 5000);
          </script>

          <!-- WhatsApp Admin CTA -->
          <% if (typeof adminPhone !== 'undefined' && adminPhone) { 
            let waClean = String(adminPhone).replace(/\D/g, '');
            if (waClean.startsWith('0')) waClean = '62' + waClean.slice(1);
          %>
            <a href="https://wa.me/<%= waClean %>?text=Halo%20Admin%20<%= encodeURIComponent(company || '') %>,%20saya%20ingin%20bertanya%20tentang%20pembayaran%20tagihan%20saya." 
               target="_blank" rel="noopener" class="btn-action-wa mb-4">
              <i class="bi bi-whatsapp fs-5 me-1"></i> Hubungi Admin via WhatsApp
            </a>
          <% } %>

        <% } %>

        <!-- Layanan Cepat Grid -->
        <div class="quick-access-grid">
          <a href="/customer/check-billing" class="quick-access-btn">
            <i class="bi bi-receipt text-info quick-access-icon"></i>
            <span class="quick-access-label">Cek Tagihan</span>
          </a>

          <a href="/customer/voucher" class="quick-access-btn">
            <i class="bi bi-ticket-perforated text-warning quick-access-icon"></i>
            <span class="quick-access-label">Beli Voucher</span>
          </a>

          <a href="/customer/register" class="quick-access-btn">
            <i class="bi bi-person-plus text-success quick-access-icon"></i>
            <span class="quick-access-label">Pasang Baru</span>
          </a>

          <% 
            let waFooterClean = (typeof adminPhone !== 'undefined' && adminPhone) ? String(adminPhone).replace(/\D/g, '') : '';
            if (waFooterClean.startsWith('0')) waFooterClean = '62' + waFooterClean.slice(1);
          %>
          <a href="<%= waFooterClean ? 'https://wa.me/' + waFooterClean : '#' %>" target="_blank" rel="noopener" class="quick-access-btn">
            <i class="bi bi-whatsapp text-success quick-access-icon"></i>
            <span class="quick-access-label">Bantuan CS</span>
          </a>
        </div>

        <!-- Footer Links -->
        <div class="register-footer-link">
          <div class="d-flex justify-content-center flex-wrap gap-3 mb-2" style="font-size: 11px;">
            <a href="/customer/about" class="text-decoration-none text-muted">Tentang Kami</a>
            <a href="/customer/tos" class="text-decoration-none text-muted">Ketentuan Layanan</a>
            <a href="/customer/privacy" class="text-decoration-none text-muted">Kebijakan Privasi</a>
            <a href="/customer/contact" class="text-decoration-none text-muted">Kontak</a>
          </div>
          <div class="text-muted" style="font-size: 11px;">
            Sistem Billing &copy; <%= new Date().getFullYear() %> <%= (typeof company !== 'undefined' && company) ? company : 'Portal ISP' %>
          </div>
        </div>

      </div>

    </div>

  </div>

</body>

</html>

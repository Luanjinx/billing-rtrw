<!-- views/partials/customer_bottom_nav.ejs -->
<% if (typeof isLoggedIn === 'undefined' || isLoggedIn) { %>
<style>
  .customer-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 66px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 99999 !important;
    padding: 4px 6px calc(4px + env(safe-area-inset-bottom)) 6px;
    box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.12);
    pointer-events: auto !important;
  }

  .customer-bottom-nav .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    text-decoration: none !important;
    font-size: 11px;
    font-weight: 600;
    transition: all 0.2s ease;
    flex: 1;
    height: 52px;
    border-radius: 14px;
    cursor: pointer;
    position: relative;
    margin: 0 2px;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto !important;
  }

  .customer-bottom-nav .nav-item * {
    pointer-events: none !important;
  }

  .customer-bottom-nav .nav-item i {
    font-size: 20px;
    line-height: 1;
    margin-bottom: 3px;
    transition: transform 0.2s ease, color 0.2s ease;
    color: inherit;
  }

  .customer-bottom-nav .nav-item span {
    font-size: 11px;
    line-height: 1.1;
    color: inherit;
  }

  .customer-bottom-nav .nav-item:hover {
    color: #12504b;
    background: rgba(18, 80, 75, 0.04);
  }

  .customer-bottom-nav .nav-item.active {
    color: #12504b !important;
    font-weight: 700;
    background: #e6f2f1;
    box-shadow: inset 0 0 0 1px rgba(18, 80, 75, 0.15);
  }

  .customer-bottom-nav .nav-item.active i {
    transform: translateY(-1px) scale(1.05);
    color: #12504b !important;
  }

  @media (max-width: 991.98px) {
    body {
      padding-bottom: 74px !important;
    }
    .modal:not(#notifDrawerModal) {
      z-index: 100005 !important;
    }
    .modal-backdrop {
      z-index: 100000 !important;
    }
    .modal:not(#notifDrawerModal) .modal-dialog {
      z-index: 100005 !important;
    }
    .modal:not(#notifDrawerModal) .modal-content {
      padding-bottom: calc(75px + env(safe-area-inset-bottom)) !important;
    }
  }

  @media (min-width: 992px) {
    .customer-bottom-nav {
      display: flex !important;
      max-width: 520px;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 20px 20px 0 0;
      border: 1px solid #cbd5e1;
      border-bottom: none;
    }
    body {
      padding-bottom: 74px !important;
    }
  }
</style>

<nav class="customer-bottom-nav" id="customerBottomNav">
  <a href="/customer/dashboard" class="nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'home') ? 'active' : '' %>">
    <i class="bi bi-house-door-fill"></i>
    <span>Beranda</span>
  </a>

  <a href="/customer/transaction" class="nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'billing') ? 'active' : '' %>">
    <i class="bi bi-card-checklist"></i>
    <span>Transaksi</span>
  </a>

  <a href="/customer/packages" class="nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'packages') ? 'active' : '' %>">
    <i class="bi bi-cart3"></i>
    <span>Paket</span>
  </a>

  <a href="/customer/help" class="nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'support') ? 'active' : '' %>">
    <i class="bi bi-chat-dots-fill"></i>
    <span>Bantuan</span>
  </a>

  <a href="/customer/account" class="nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'account') ? 'active' : '' %>">
    <i class="bi bi-person-circle"></i>
    <span>Akun</span>
  </a>
</nav>

<script>
  function triggerTicketNav() {
    const el = document.getElementById('ticketModal');
    if (el && typeof bootstrap !== 'undefined') {
      const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
      m.show();
    } else {
      window.location.href = '/customer/dashboard#ticket-section';
    }
  }
</script>
<% } %>

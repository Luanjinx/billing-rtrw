<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('customer.pages.about.meta_title', 'Tentang Kami') %> | <%= (typeof company !== 'undefined' && company) ? company : 'MyRepublic' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="theme-color" content="#12504b">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
      --primary-color: #12504b;
      --primary-dark: #0e3f3b;
      --primary-light: #e6f2f1;
      --text-main: #0f2d2a;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      background: #ffffff;
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding-bottom: 90px;
      -webkit-tap-highlight-color: transparent;
    }

    .top-header-banner {
      background: linear-gradient(180deg, #12504b 0%, #17635d 100%);
      padding: 20px 16px 50px 16px;
      color: #ffffff;
    }

    .top-brand-bar {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-back-nav {
      color: #ffffff;
      font-size: 22px;
      text-decoration: none;
      display: flex;
      align-items: center;
    }

    .header-page-title {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      margin: 0;
    }

    .floating-container {
      margin-top: -35px;
      padding: 0 16px;
    }

    .legal-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 24px;
      padding: 24px 20px;
      margin-bottom: 24px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    }

    .legal-header-box {
      text-align: center;
      padding-bottom: 20px;
      margin-bottom: 20px;
      border-bottom: 1px dashed #cbd5e1;
    }

    .legal-icon-badge {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: #e6f2f1;
      color: #12504b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      margin: 0 auto 12px auto;
    }

    .stat-box-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 18px 14px;
      text-align: center;
      height: 100%;
      transition: all 0.2s ease;
    }

    .stat-box-card:hover {
      border-color: #b2dfdb;
      transform: translateY(-2px);
    }

    .stat-box-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: #e6f2f1;
      color: #12504b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      margin: 0 auto 10px auto;
    }

    h4.section-title {
      font-size: 15px;
      font-weight: 800;
      color: #12504b;
      margin-top: 24px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    p.section-text {
      font-size: 13.5px;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 12px;
    }

    ul.legal-list {
      padding-left: 20px;
      margin-bottom: 16px;
    }

    ul.legal-list li {
      font-size: 13.5px;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 6px;
    }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
      margin-top: 20px;
      font-weight: 600;
    }
  </style>
</head>

<body>

  <!-- ── HEADER BANNER ── -->
  <div class="top-header-banner">
    <div class="container p-0">
      <div class="top-brand-bar">
        <a href="<%= (typeof isLoggedIn !== 'undefined' && isLoggedIn) ? '/customer/account' : '/customer/login' %>" class="btn-back-nav">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="header-page-title"><%= t('customer.pages.about.hero_title_prefix', 'Tentang') %> <%= (typeof company !== 'undefined' && company) ? company : 'MyRepublic' %></h1>
      </div>
    </div>
  </div>

  <!-- ── FLOATING CONTAINER ── -->
  <div class="container floating-container">
    <div class="legal-card">
      <div class="legal-header-box">
        <div class="legal-icon-badge">
          <i class="bi bi-info-circle-fill"></i>
        </div>
        <h5 class="fw-extrabold text-dark mb-1" style="font-size:17px;"><%= (typeof company !== 'undefined' && company) ? company : 'MyRepublic Fiber' %></h5>
        <p class="text-muted small mb-0" style="font-size:12px;"><%= t('customer.pages.about.hero_subtitle', 'Solusi internet cepat, stabil, dan terjangkau untuk kebutuhan Anda.') %></p>
      </div>

      <p class="section-text" style="font-size:14px; font-weight:500;">
        <%- String(t('customer.pages.about.p1', '<strong>{company}</strong> adalah penyedia layanan internet serat optik (Fiber Optic) yang berfokus pada penyediaan akses broadband berkualitas tinggi untuk perumahan dan usaha.')).replace('{company}', company || 'MyRepublic') %>
      </p>

      <p class="section-text">
        <%= t('customer.pages.about.p2', 'Kami percaya bahwa di era digital saat ini, akses internet yang stabil dan cepat bukan lagi kemewahan, melainkan kebutuhan utama untuk mendukung pendidikan, bisnis digital, hiburan, dan komunikasi tanpa batas.') %>
      </p>

      <!-- Stat Cards Row -->
      <div class="row g-3 my-3">
        <div class="col-4">
          <div class="stat-box-card">
            <div class="stat-box-icon">
              <i class="bi bi-rocket-takeoff-fill"></i>
            </div>
            <h6 class="fw-extrabold text-dark mb-1" style="font-size:13px;"><%= t('customer.pages.about.stats.speed_title', 'Kecepatan Tinggi') %></h6>
            <p class="text-muted small mb-0" style="font-size:11px; line-height:1.3;"><%= t('customer.pages.about.stats.speed_desc', 'Jaringan fiber optik tanpa hambatan.') %></p>
          </div>
        </div>

        <div class="col-4">
          <div class="stat-box-card">
            <div class="stat-box-icon">
              <i class="bi bi-shield-check"></i>
            </div>
            <h6 class="fw-extrabold text-dark mb-1" style="font-size:13px;"><%= t('customer.pages.about.stats.stable_title', 'Stabil & Aman') %></h6>
            <p class="text-muted small mb-0" style="font-size:11px; line-height:1.3;"><%= t('customer.pages.about.stats.stable_desc', 'Keandalan jaringan maksimal 24/7.') %></p>
          </div>
        </div>

        <div class="col-4">
          <div class="stat-box-card">
            <div class="stat-box-icon">
              <div style="color:#12504b;"><i class="bi bi-headset"></i></div>
            </div>
            <h6 class="fw-extrabold text-dark mb-1" style="font-size:13px;"><%= t('customer.pages.about.stats.support_title', 'Dukungan Siap') %></h6>
            <p class="text-muted small mb-0" style="font-size:11px; line-height:1.3;"><%= t('customer.pages.about.stats.support_desc', 'Tim teknis yang responsif membantu Anda.') %></p>
          </div>
        </div>
      </div>

      <h4 class="section-title">
        <i class="bi bi-eye-fill"></i> <%= t('customer.pages.about.vision_title', 'Visi Kami') %>
      </h4>
      <p class="section-text">
        <%= t('customer.pages.about.vision_body', 'Menjadi mitra konektivitas digital terpercaya yang mampu menjangkau hingga pelosok, memberikan dampak positif bagi perkembangan ekonomi dan sosial masyarakat.') %>
      </p>

      <h4 class="section-title">
        <i class="bi bi-bullseye"></i> <%= t('customer.pages.about.mission_title', 'Misi Kami') %>
      </h4>
      <ul class="legal-list">
        <li><%= t('customer.pages.about.mission_1', 'Menyediakan layanan internet dengan harga yang kompetitif namun berkualitas premium.') %></li>
        <li><%= t('customer.pages.about.mission_2', 'Terus berinovasi dalam infrastruktur jaringan untuk mengikuti perkembangan teknologi.') %></li>
        <li><%= t('customer.pages.about.mission_3', 'Memberikan layanan pelanggan yang responsif, ramah, dan solutif.') %></li>
      </ul>

      <div class="footer-note">
        &copy; <%= new Date().getFullYear() %> <%= company || 'MyRepublic' %> • <%= t('customer.pages.about.footer_tagline', 'Menghubungkan Anda ke Masa Depan') %>
      </div>
    </div>
  </div>

  <%- include('partials/customer_bottom_nav', { activeNav: (typeof isLoggedIn !== 'undefined' && isLoggedIn) ? 'account' : 'none' }) %>

</body>

</html>

              <li class="mb-1">Tekan tombol <strong>Share (Bagikan)</strong> <i class="bi bi-share text-primary"></i> di menu bawah Safari.</li>
              <li class="mb-1">Geser ke bawah dan pilih <strong>"Add to Home Screen" (Tambah ke Layar Utama)</strong> <i class="bi bi-plus-square text-primary"></i>.</li>
              <li>Tekan <strong>Add (Tambah)</strong> di pojok kanan atas.</li>
            </ol>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" id="modal-btn-install-direct" class="btn btn-warning fw-bold px-4 py-2" onclick="triggerPwaInstallDirect()">
            <i class="bi bi-download me-1"></i> Install Sekarang
          </button>
          <button type="button" class="btn btn-outline-secondary px-4 py-2" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let deferredPwaPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      if (!localStorage.getItem('pwa_banner_dismissed')) {
        const banner = document.getElementById('pwa-install-banner');
        if (banner) banner.style.display = 'block';
      }
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
            const modalEl = document.getElementById('pwaInstallModal');
            if (modalEl) {
              const instance = bootstrap.Modal.getInstance(modalEl);
              if (instance) instance.hide();
            }
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }
  </script>

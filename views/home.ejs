<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= settings.company_header || 'Portal ISP' %> | <%= t('customer.home_title', 'Internet Fiber Optic Super Cepat & Stabil') %></title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#317fe4">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary: #317fe4;
      --primary-dark: #1f5eb1;
      --primary-light: #eff6ff;
      --primary-border: #bfdbfe;
      --accent: #10b981;
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --border-color: #e2e8f0;
      --text-main: #0f172a;
      --text-muted-custom: #64748b;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-body);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
      margin: 0;
    }

    .white-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .white-card:hover {
      border-color: var(--primary-border);
      box-shadow: 0 18px 45px rgba(18, 80, 75, 0.08);
    }

    /* ── NAVBAR ── */
    .custom-navbar {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      padding: 10px 0;
      transition: all 0.3s ease;
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.03);
    }

    .navbar-brand {
      white-space: nowrap;
    }

    .navbar-brand img {
      height: 36px;
      width: auto;
      object-fit: contain;
    }

    .nav-link {
      color: #334155 !important;
      font-weight: 700;
      font-size: 13px;
      padding: 8px 14px !important;
      border-radius: 12px;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .nav-link:hover, .nav-link.active {
      color: var(--primary) !important;
      background: var(--primary-light);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-actions .btn {
      white-space: nowrap;
      height: 38px;
      padding: 0 14px !important;
      font-size: 12.5px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border-radius: 12px;
    }

    .btn-portal-access {
      background: var(--primary);
      color: #fff !important;
      font-weight: 800;
      border: none;
      box-shadow: 0 4px 16px rgba(18, 80, 75, 0.25);
      transition: all 0.3s ease;
    }

    .btn-portal-access:hover {
      transform: translateY(-1px);
      background: var(--primary-dark);
      box-shadow: 0 6px 20px rgba(18, 80, 75, 0.35);
      color: #fff !important;
    }

    /* ── HERO SECTION ── */
    .hero-section {
      padding: 70px 0 90px;
      background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%);
      position: relative;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      border: 1px solid var(--primary-border);
      color: var(--primary);
      padding: 8px 18px;
      border-radius: 30px;
      font-size: 0.88rem;
      font-weight: 800;
      margin-bottom: 22px;
      box-shadow: 0 4px 14px rgba(49, 127, 228, 0.08);
    }

    .hero-title {
      font-size: 3.2rem;
      font-weight: 800;
      line-height: 1.18;
      margin-bottom: 20px;
      color: #0f172a;
      letter-spacing: -0.5px;
    }

    .hero-title span {
      color: var(--primary);
      background: linear-gradient(135deg, #317fe4 0%, #2563eb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.15rem;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 36px;
    }

    /* Hero Image & Visual Card */
    .hero-visual-card {
      position: relative;
      background: #ffffff;
      border: 1px solid var(--primary-border);
      border-radius: 28px;
      padding: 16px;
      box-shadow: 0 20px 50px rgba(49, 127, 228, 0.14);
      animation: floatHero 5s ease-in-out infinite;
    }

    @keyframes floatHero {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .hero-visual-img {
      width: 100%;
      height: auto;
      max-height: 380px;
      object-fit: cover;
      border-radius: 20px;
      display: block;
    }

    .hero-floating-badge {
      position: absolute;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--primary-border);
      padding: 10px 16px;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.85rem;
      font-weight: 800;
      color: #0f172a;
    }

    .hero-floating-badge-top {
      top: -16px;
      right: 20px;
    }

    .hero-floating-badge-bottom {
      bottom: -16px;
      left: 20px;
    }

    /* ── HERO STATS ── */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 16px;
      margin-top: 40px;
    }

    .stat-item {
      background: #ffffff;
      border: 1px solid var(--border-color);
      padding: 16px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
      transition: all 0.2s ease;
    }

    .stat-item:hover {
      border-color: var(--primary-border);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(49, 127, 228, 0.08);
    }

    .stat-number {
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--primary);
    }

    .stat-label {
      font-size: 0.82rem;
      color: #64748b;
      font-weight: 700;
      margin-top: 2px;
    }

    /* ── SECTION STYLING ── */
    .section-padding {
      padding: 85px 0;
    }

    .section-title-badge {
      display: inline-block;
      background: var(--primary-light);
      border: 1px solid var(--primary-border);
      color: var(--primary);
      padding: 6px 18px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .section-title {
      font-size: 2.3rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 16px;
    }

    .section-subtitle {
      color: #64748b;
      font-size: 1.05rem;
      max-width: 650px;
      margin: 0 auto 48px;
      line-height: 1.6;
    }

    /* ── PACKAGE CARDS ── */
    .pkg-card {
      padding: 34px 28px;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
      border-radius: 24px;
      background: #ffffff;
    }

    .pkg-badge-popular {
      position: absolute;
      top: -14px;
      right: 24px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 800;
      padding: 5px 14px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
    }

    .pkg-speed-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--primary-light);
      border: 1px solid var(--primary-border);
      color: var(--primary);
      padding: 6px 16px;
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 800;
      margin-bottom: 18px;
      width: fit-content;
    }

    .pkg-name {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
    }

    .pkg-price {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 2px;
    }

    .pkg-period {
      font-size: 0.88rem;
      color: #64748b;
      margin-bottom: 22px;
    }

    .pkg-features {
      list-style: none;
      padding: 0;
      margin: 0 0 28px 0;
      flex-grow: 1;
    }

    .pkg-features li {
      padding: 9px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.95rem;
      color: #334155;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pkg-features li i {
      color: #10b981;
      font-size: 1.1rem;
    }

    .btn-pkg-action {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      color: #0f172a;
      border-radius: 14px;
      padding: 13px;
      font-weight: 700;
      text-decoration: none;
      text-align: center;
      transition: all 0.3s ease;
    }

    .btn-pkg-action:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
      box-shadow: 0 8px 22px rgba(49, 127, 228, 0.3);
    }

    /* ── FEATURE CARDS ── */
    .feature-box {
      padding: 30px 24px;
      height: 100%;
      border-radius: 20px;
      background: #ffffff;
    }

    .feature-icon-wrapper {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: var(--primary-light);
      border: 1px solid var(--primary-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      color: var(--primary);
      margin-bottom: 22px;
    }

    .feature-title {
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 10px;
    }

    .feature-desc {
      color: #64748b;
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    /* ── INFO CARDS ── */
    .info-card {
      padding: 24px;
      border-radius: 20px;
      display: flex;
      align-items: flex-start;
      gap: 16px;
      height: 100%;
      background: #ffffff;
      transition: all 0.3s ease;
    }

    .info-card h5 {
      color: #0f172a !important;
      font-weight: 800;
      font-size: 1.1rem;
    }

    .info-card p, .info-card .card-text-desc {
      color: #64748b !important;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .info-card-link:hover .info-card {
      transform: translateY(-4px);
      border-color: var(--primary-border);
      box-shadow: 0 12px 30px rgba(49, 127, 228, 0.12);
    }

    .info-icon {
      font-size: 1.8rem;
      color: var(--primary);
      background: var(--primary-light);
      border: 1px solid var(--primary-border);
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* ── FOOTER ── */
    .site-footer {
      background: #0f172a;
      color: #ffffff;
      padding: 65px 0 30px;
    }

    .footer-brand img {
      height: 40px;
      margin-bottom: 15px;
    }

    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links li {
      margin-bottom: 10px;
    }

    .footer-links a {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.94rem;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #5eead4;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      margin-top: 40px;
      padding-top: 25px;
      font-size: 0.9rem;
      color: #cbd5e1;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .hero-title {
        font-size: 2.2rem;
      }
      .hero-section {
        padding: 40px 0 60px;
      }
      .section-title {
        font-size: 1.8rem;
      }
      .navbar-collapse {
        background: #ffffff;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        margin-top: 12px;
        border: 1px solid #e2e8f0;
      }
      .navbar-collapse .d-flex, .navbar-collapse .nav-actions {
        flex-direction: column;
        width: 100%;
        gap: 10px !important;
      }
      .navbar-collapse .btn, .navbar-collapse .btn-portal-access {
        width: 100%;
        justify-content: center;
      }
    }

    @media (max-width: 575.98px) {
      .hero-title {
        font-size: 1.85rem;
        line-height: 1.25;
      }
      .hero-subtitle {
        font-size: 1rem;
        line-height: 1.6;
      }
      .hero-stats {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }
      .stat-item {
        padding: 12px 8px;
      }
      .stat-number {
        font-size: 1.15rem;
      }
      .stat-label {
        font-size: 0.78rem;
      }
    }
  </style>
</head>

<body>

  <!-- Header / Navbar Section -->
  <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/customer/home">
        <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" alt="Logo" onerror="this.style.display='none'">
      </a>

      <button class="navbar-toggler border-0 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list fs-2"></i>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
          <li class="nav-item">
            <a class="nav-link active" href="#hero"><i class="bi bi-house-door me-1"></i> Beranda</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#packages"><i class="bi bi-wifi me-1"></i> Paket & Tarif</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#features"><i class="bi bi-shield-check me-1"></i> Keunggulan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#services"><i class="bi bi-grid me-1"></i> Layanan Cepat</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact-info"><i class="bi bi-headset me-1"></i> Informasi</a>
          </li>
        </ul>

        <div class="nav-actions mt-3 mt-lg-0">
          <button type="button" id="btn-install-pwa-nav" class="btn btn-warning shadow-sm" onclick="triggerPwaInstall()">
            <i class="bi bi-download"></i> Install Aplikasi
          </button>
          <a href="/customer/check-billing" class="btn btn-outline-secondary">
            <i class="bi bi-receipt"></i> Cek Tagihan
          </a>
          <a href="/customer/login" class="btn btn-portal-access">
            <i class="bi bi-box-arrow-in-right"></i> Masuk Portal
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-section" id="hero">
    <div class="container">
      <div class="row align-items-center g-5">

        <!-- Left Column: Value Proposition -->
        <div class="col-lg-6">
          <div class="hero-badge">
            <i class="bi bi-lightning-charge-fill text-warning"></i>
            <span>Internet Fiber Optic Super Cepat & Unlimited</span>
          </div>

          <h1 class="hero-title">
            Nikmati Koneksi Internet <span>Super Cepat</span> Tanpa Batas Kuota
          </h1>

          <p class="hero-subtitle">
            Selamat datang di portal resmi <strong><%= settings.company_header %></strong>. Kami menyediakan jaringan internet ultra cepat, stabil, dan terjangkau untuk kebutuhan rumah tangga, bisnis, gaming, hingga hiburan keluarga Anda.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="/customer/login" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 py-3 shadow-lg d-inline-flex align-items-center justify-content-center" style="background: var(--primary); border: none; min-width: 220px;">
              <i class="bi bi-box-arrow-in-right me-2 fs-5"></i> Masuk Portal Pelanggan
            </a>
            <a href="/customer/register" class="btn btn-outline-dark btn-lg rounded-3 fw-bold px-4 py-3 d-inline-flex align-items-center justify-content-center" style="background: #ffffff; border-color: #cbd5e1; min-width: 220px;">
              <i class="bi bi-person-plus-fill me-2 fs-5 text-primary"></i> Daftar Pasang Baru
            </a>
          </div>

          <!-- Highlight Badges -->
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-speedometer2 text-info me-1"></i> 100%</div>
              <div class="stat-label">Fiber Optic</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-infinity text-success me-1"></i> No FUP</div>
              <div class="stat-label">Bebas Kuota</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-shield-lock-fill text-warning me-1"></i> 99.9%</div>
              <div class="stat-label">Uptime SLA</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-headset text-primary me-1"></i> 24/7</div>
              <div class="stat-label">Bantuan CS</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Hero Visual Image Card -->
        <div class="col-lg-6">
          <div class="hero-visual-card">
            <!-- Floating Badge Top -->
            <div class="hero-floating-badge hero-floating-badge-top">
              <div class="bg-success rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                <i class="bi bi-check-lg text-white" style="font-size: 14px;"></i>
              </div>
              <div>
                <div style="font-size: 11px; color: #64748b; font-weight: 700; line-height: 1;">Status Layanan</div>
                <div style="font-size: 13px; color: #0f172a; font-weight: 800;">100% Online & Stabil</div>
              </div>
            </div>

            <!-- Main Image -->
            <img src="/img/hero_visual.png" alt="Fiber Optic Network Visual" class="hero-visual-img" onerror="this.src='/img/logo.png'">

            <!-- Floating Badge Bottom -->
            <div class="hero-floating-badge hero-floating-badge-bottom">
              <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-speedometer2 fs-5"></i>
              </div>
              <div>
                <div style="font-size: 11px; color: #64748b; font-weight: 700; line-height: 1;">Kapasitas Jaringan</div>
                <div style="font-size: 13px; color: #317fe4; font-weight: 800;">Ultra Fast 100 Mbps+</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Internet Packages Section -->
  <section class="section-padding" id="packages">
    <div class="container">
      <div class="text-center">
        <span class="section-title-badge"><i class="bi bi-wifi me-1"></i> Pilihan Paket Internet</span>
        <h2 class="section-title">Paket & Tarif Layanan Kami</h2>
        <p class="section-subtitle">
          Pilih kecepatan koneksi yang sesuai dengan kebutuhan aktivitas digital Anda, dari penggunaan rumah hingga kantor.
        </p>
      </div>

      <% const pkgs = (typeof packages !== 'undefined' && Array.isArray(packages)) ? packages : []; %>
      <% if (pkgs.length === 0) { %>
        <div class="white-card text-center p-5 max-w-lg mx-auto">
          <i class="bi bi-info-circle fs-1 text-info mb-3 d-block"></i>
          <h5 class="fw-bold text-dark">Belum Ada Paket Dipublikasikan</h5>
          <p class="text-muted mb-0">Silakan hubungi customer service kami untuk informasi ketersediaan paket terkini.</p>
        </div>
      <% } else { %>
        <% const list = pkgs.slice().sort((a,b) => Number(a.price||0) - Number(b.price||0)); %>
        <div class="row g-4 justify-content-center">
          <% list.forEach((p, index) => { %>
            <div class="col-md-6 col-lg-4">
              <div class="white-card pkg-card">
                <% if (index === Math.floor(list.length / 2)) { %>
                  <div class="pkg-badge-popular"><i class="bi bi-star-fill me-1"></i> Terpopuler</div>
                <% } %>

                <div class="pkg-speed-tag">
                  <i class="bi bi-speedometer2 me-1"></i>
                  <% if (Number(p.speed_down||0) > 0) { %>

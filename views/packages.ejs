<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Paket Internet | <%= settings && settings.company_header ? settings.company_header : 'MyRepublic' %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="theme-color" content="#12504b">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
      --myrep-purple-primary: #12504b;
      --myrep-purple-dark: #0e3f3b;
      --myrep-purple-light: #e6f2f1;
      --myrep-purple-border: #b2dfdb;
      --bg-main: #12504b;
      --card-bg: #ffffff;
      --text-main: #0f2d2a;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      background: #ffffff;
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding-bottom: 85px;
      -webkit-tap-highlight-color: transparent;
    }

    /* ── HEADER BANNER ── */
    .packages-header-hero {
      background: linear-gradient(180deg, #12504b 0%, #1a6b65 50%, #12504b 100%);
      padding: 20px 16px 36px 16px;
      color: #ffffff;
    }

    .top-brand-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.3px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      white-space: nowrap;
    }

    .status-pill.online {
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
    }

    .status-pill.suspended {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      position: relative;
    }

    .pulse-dot.green {
      background-color: #10b981;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse-green 2s infinite;
    }

    .pulse-dot.red {
      background-color: #ef4444;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      animation: pulse-red 2s infinite;
    }

    @keyframes pulse-green {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      }

      70% {
        box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    @keyframes pulse-red {
      0% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      }

      70% {
        box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
      }
    }

    .myrep-logo-group {
      display: flex;
      align-items: center;
      gap: 8px;
      align-items: center;
      gap: 12px;
    }

    .btn-back-nav {
      color: #ffffff;
      font-size: 22px;
      text-decoration: none;
      display: flex;
      align-items: center;
    }

    .header-page-title {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      margin: 0;
    }

    .packages-floating-container {
      margin-top: -35px;
      padding: 0 16px;
    }

    .pkg-animated-hero-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 22px;
      padding: 22px 18px;
      margin-bottom: 18px;
      box-shadow: 0 6px 25px rgba(0, 0, 0, 0.05);
      text-align: center;
    }

    .packages-top-header {
      background: linear-gradient(180deg, #12504b 0%, #17635d 100%);
      padding: 20px 16px 50px 16px;
      color: #ffffff;
    }

    .wifi-hero-animated-badge {
      position: relative;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      margin: 0 auto;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .wifi-hero-animated-badge::before,
    .wifi-hero-animated-badge::after {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.4);
      animation: heroWifiRipple 2.4s infinite ease-out;
      pointer-events: none;
    }

    .wifi-hero-animated-badge::after {
      animation-delay: 1.2s;
    }

    @keyframes heroWifiRipple {
      0% {
        transform: scale(0.9);
        opacity: 0.9;
      }

      100% {
        transform: scale(1.5);
        opacity: 0;
      }
    }

    .wifi-hero-animated-badge i {
      animation: heroIconFloat 2.2s infinite ease-in-out;
    }

    @keyframes heroIconFloat {

      0%,
      100% {
        transform: translateY(0) scale(1);
      }

      50% {
        transform: translateY(-4px) scale(1.08);
      }
    }

    .myrep-logo-group {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #ffffff;
      font-weight: 800;
      font-size: 18px;
    }

    /* ── MAIN CONTENT SHEET ── */
    .packages-sheet {
      background: #ffffff;
      border-radius: 28px 28px 0 0;
      margin-top: -24px;
      position: relative;
      z-index: 10;
      padding: 24px 16px 90px 16px;
      min-height: calc(100vh - 160px);
      box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.12);
    }

    /* Category Header */
    .category-header-box {
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      background: #f8fafc;
    }

    .category-header-title {
      font-weight: 800;
      font-size: 15px;
      color: #0f2d2a;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .category-header-sub {
      font-size: 11px;
      color: #64748b;
      margin-top: 2px;
    }

    .btn-change-cat {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      color: #334155;
      font-size: 11px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 8px;
    }

    /* Nav Tabs Filter */
    .pkg-nav-tabs {
      display: flex;
      justify-content: center;
      gap: 28px;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 10px;
      margin-bottom: 16px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .pkg-nav-tabs::-webkit-scrollbar {
      display: none;
    }

    .pkg-tab-item {
      font-weight: 700;
      font-size: 14px;
      color: #64748b;
      cursor: pointer;
      padding-bottom: 8px;
      position: relative;
      transition: color 0.2s ease;
      text-decoration: none;
    }

    .pkg-tab-item.active {
      color: #12504b;
    }

    .pkg-tab-item.active::after {
      content: '';
      position: absolute;
      bottom: -11px;
      left: 0;
      right: 0;
      height: 3px;
      background: #12504b;
      border-radius: 3px;
    }

    /* Sub-category Pills Filter */
    .pkg-pills-filter {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      margin-bottom: 24px;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .pkg-pills-filter::-webkit-scrollbar {
      display: none;
    }

    .pkg-pill {
      background: #f1f5f9;
      color: #475569;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .pkg-pill.active {
      background: #00a896;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(0, 168, 150, 0.25);
    }

    /* ── CARD GRID (2 COLUMNS MOBILE) ── */
    .package-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    @media (max-width: 480px) {
      .package-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
    }

    @media (min-width: 768px) {
      .package-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }
    }

    @media (min-width: 1024px) {
      .package-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }
    }

    .package-card {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .package-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }

    .package-cover {
      height: 58px;
      background: linear-gradient(135deg, #12504b 0%, #20756e 100%);
      position: relative;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #ffffff;
      overflow: hidden;
    }

    .package-cover::after {
      content: '';
      position: absolute;
      right: -15px;
      bottom: -15px;
      width: 65px;
      height: 65px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
    }

    .brand-tag {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: rgba(255, 255, 255, 0.85);
      text-transform: uppercase;
      z-index: 2;
    }

    .speed-badge-pill {
      background: rgba(255, 255, 255, 0.95);
      color: #12504b;
      padding: 4px 10px;
      border-radius: 10px;
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
      z-index: 2;
    }

    .speed-badge-pill .speed-val {
      font-weight: 900;
      font-size: 16px;
      line-height: 1;
    }

    .speed-badge-pill .speed-unit {
      font-weight: 700;
      font-size: 10px;
    }

    .package-body {
      padding: 10px 12px 12px 12px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
    }

    .package-title {
      font-weight: 800;
      font-size: 13.5px;
      color: #0f2d2a;
      margin-bottom: 2px;
      text-transform: uppercase;
      letter-spacing: 0.2px;
      line-height: 1.2;
    }

    .package-speed-desc {
      font-size: 10.5px;
      color: #64748b;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .package-price-box {
      margin-top: 4px;
    }

    .package-price {
      font-weight: 900;
      font-size: 15px;
      color: #12504b;
      line-height: 1.1;
    }

    .package-period {
      font-size: 10px;
      color: #64748b;
      font-weight: 600;
      margin-top: 1px;
    }

    .btn-choose-package {
      margin-top: 8px;
      width: 100%;
      background: #e6f2f1;
      color: #12504b;
      border: 1px solid #b2dfdb;
      font-weight: 800;
      font-size: 11.5px;
      padding: 7px 8px;
      border-radius: 10px;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-choose-package:hover {
      background: #12504b;
      color: #ffffff;
    }
  </style>
</head>

<body>

  <!-- ── HEADER BANNER ── -->
  <div class="packages-top-header">
    <div class="container p-0">
      <div class="text-center py-2">
        <div class="wifi-hero-animated-badge">
          <i class="bi bi-rocket-takeoff-fill"></i>
        </div>
        <h5 class="fw-extrabold text-white mt-3 mb-1" style="font-size: 18px;">Paket Internet High-Speed</h5>
        <p class="text-white-50 small mb-0" style="font-size: 12.5px;">Pilih paket internet unlimited ultra cepat untuk
          semua kebutuhan digital Anda</p>
      </div>
    </div>
  </div>

  <!-- ── MAIN CONTENT SHEET ── -->
  <div class="packages-sheet">
    <div class="container p-0">

      <!-- Main Category Tabs -->
      <div class="pkg-nav-tabs">
        <div class="pkg-tab-item active" onclick="switchCategory('internet', this)">Paket Internet</div>
        <div class="pkg-tab-item" onclick="switchCategory('voucher', this)">Voucher Hotspot</div>
      </div>

      <!-- Sub-category Pills Filter -->
      <div class="pkg-pills-filter">
        <div class="pkg-pill active" onclick="filterSpeed('all', this)">Semua Kecepatan</div>
        <div class="pkg-pill" onclick="filterSpeed('50', this)">10 - 50 Mbps</div>
        <div class="pkg-pill" onclick="filterSpeed('100', this)">100 Mbps+</div>
        <div class="pkg-pill" onclick="filterSpeed('300', this)">300 Mbps+</div>
        <div class="pkg-pill" onclick="filterSpeed('500', this)">500 Mbps+</div>
      </div>

      <!-- ── CARD GRID (2 COLUMNS) ── -->
      <div class="package-grid" id="packageGrid">
        <% if (typeof packages !=='undefined' && packages && packages.length> 0) { %>
          <% packages.forEach((pkg, idx)=> { %>
            <% const speedMbps=Math.round((pkg.speed_down || 0) / 1000); const upSpeedMbps=Math.round((pkg.speed_up ||
              0) / 1000); const uptoMbps=pkg.speed_down_upto ? Math.round(pkg.speed_down_upto / 1000) : 0; %>
              <div class="package-card" data-category="internet" data-speed="<%= speedMbps %>"
                data-type="<%= (pkg.billing_type || 'postpaid') %>">
                <div class="package-cover"
                  style="background: <%= idx % 2 === 0 ? 'linear-gradient(135deg, #12504b 0%, #20756e 100%)' : 'linear-gradient(135deg, #0e3f3b 0%, #1a6b65 100%)' %>;">
                  <div class="brand-tag">FIBER ULTRA</div>
                  <div class="speed-badge-pill">
                    <span class="speed-val">
                      <%= speedMbps %>
                    </span>
                    <span class="speed-unit">Mbps</span>
                  </div>
                </div>
                <div class="package-body">
                  <div>
                    <div class="package-title">
                      <%= pkg.name %>
                    </div>
                    <div class="package-speed-desc">
                      <% if (uptoMbps> 0) { %>
                        <%= speedMbps %> Mbps Up to <%= uptoMbps %> Mbps
                            <% } else { %>
                              Down: <%= speedMbps %>M | Up: <%= upSpeedMbps %>M
                                  <% } %>
                    </div>
                  </div>

                  <div class="package-price-box">
                    <div class="package-price">Rp <%= (pkg.price || 0).toLocaleString('id-ID') %>
                    </div>
                    <div class="package-period">/ <%= pkg.billing_type==='prepaid' ? (pkg.duration_days + ' Hari' )
                        : 'Bulan' %>
                    </div>

                    <button type="button" class="btn-choose-package"
                      onclick="selectPkg('<%= pkg.name %>', '<%= pkg.price %>')">
                      Pilih Paket
                    </button>
                  </div>
                </div>
              </div>
              <% }) %>
                <% } %>

                  <!-- Voucher Packages (If Available) -->
                  <% if (typeof voucherPackages !=='undefined' && voucherPackages && voucherPackages.length> 0) { %>
                    <% voucherPackages.forEach((vp, idx)=> { %>
                      <div class="package-card" data-category="voucher" data-speed="voucher" data-type="voucher">
                        <div class="package-cover"
                          style="background: linear-gradient(135deg, #00a896 0%, #028090 100%);">
                          <div class="brand-tag">Voucher Hotspot</div>
                          <div class="speed-badge-pill">
                            <span class="speed-val">
                              <%= vp.validity || '1d' %>
                            </span>
                            <span class="speed-unit">Masa Aktif</span>
                          </div>
                        </div>
                        <div class="package-body">
                          <div>
                            <div class="package-title">
                              <%= vp.profile_name %>
                            </div>
                            <div class="package-speed-desc">Router: <%= vp.router_name || 'MikroTik' %>
                            </div>
                          </div>

                          <div class="package-price-box">
                            <div class="package-price">Rp <%= (vp.price || 0).toLocaleString('id-ID') %>
                            </div>
                            <div class="package-period">/ <%= vp.validity || 'Voucher' %>
                            </div>

                            <a href="/public/voucher"
                              class="btn-choose-package text-center d-block text-decoration-none"
                              style="margin-top:10px;">
                              Beli Voucher
                            </a>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                        <% } %>
      </div>

    </div>
  </div>

  <%- include('partials/customer_bottom_nav', { activeNav: 'packages' , isLoggedIn: true }) %>

    <script>
      function switchCategory(cat, el) {
        if (el) {
          document.querySelectorAll('.pkg-tab-item').forEach(item => item.classList.remove('active'));
          el.classList.add('active');
        }

        const pillsContainer = document.querySelector('.pkg-pills-filter');
        if (pillsContainer) {
          pillsContainer.style.display = (cat === 'voucher') ? 'none' : 'flex';
        }

        const firstPill = document.querySelector('.pkg-pill');
        if (firstPill) {
          document.querySelectorAll('.pkg-pill').forEach(pill => pill.classList.remove('active'));
          firstPill.classList.add('active');
        }

        const cards = document.querySelectorAll('#packageGrid .package-card');
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      function filterSpeed(speed, el) {
        document.querySelectorAll('.pkg-pill').forEach(pill => pill.classList.remove('active'));
        el.classList.add('active');

        const cards = document.querySelectorAll('#packageGrid .package-card[data-category="internet"]');
        cards.forEach(card => {
          const cardSpeed = parseInt(card.getAttribute('data-speed')) || 0;
          if (speed === 'all') {
            card.style.display = 'flex';
          } else if (speed === '50' && cardSpeed <= 50) {
            card.style.display = 'flex';
          } else if (speed === '100' && cardSpeed >= 100 && cardSpeed < 300) {
            card.style.display = 'flex';
          } else if (speed === '300' && cardSpeed >= 300 && cardSpeed < 500) {
            card.style.display = 'flex';
          } else if (speed === '500' && cardSpeed >= 500) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      function selectPkg(name, price) {
        const waNumber = '<%= (settings && settings.company_phone) ? settings.company_phone.replace(/\\D/g, "") : "" %>';
        const msg = encodeURIComponent(`Halo Admin, saya berminat untuk berlangganan / upgrade ke paket: ${name} (Rp ${parseInt(price).toLocaleString('id-ID')}). Mohon bantuannya.`);
        window.open(`https://wa.me/${waNumber}?text=${msg}`, '_blank');
      }

      document.addEventListener('DOMContentLoaded', () => {
        const activeTab = document.querySelector('.pkg-tab-item.active');
        if (activeTab) {
          switchCategory('internet', activeTab);
        }
      });
    </script>
</body>

</html>

  <div class="modal fade" id="editPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="dock-sheet-handle"></div>
        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
          <h6 class="fw-extrabold text-dark mb-0 d-flex align-items-center gap-2" style="font-size:16px;">
            <i class="bi bi-key-fill text-success fs-5"></i> Ubah Password WiFi
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:12px;"></button>
        </div>
        <form action="/customer/change-password" method="POST">
          <div class="modal-body p-2">
            <div class="mb-3">
              <label class="form-label fw-bold">Password WiFi Baru (Minimal 8 Karakter)</label>
              <input type="password" name="password" id="modalPassInput" class="form-control p-3" minlength="8"
                style="border-radius:12px;" required>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0 pb-2 px-2 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal"
              style="border-radius:12px;">Batal</button>
            <button type="submit" class="btn btn-success text-white fw-bold px-4 flex-grow-1"
              style="border-radius:12px;">Simpan Password</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="rebootModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="dock-sheet-handle"></div>
        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
          <h6 class="fw-extrabold text-dark mb-0 d-flex align-items-center gap-2" style="font-size:16px;">
            <i class="bi bi-arrow-clockwise text-warning fs-5"></i> Restart Modem
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:12px;"></button>
        </div>
        <form action="/customer/reboot" method="POST">
          <div class="modal-body p-3 text-center">
            <div class="p-3 mb-3 rounded-circle bg-warning bg-opacity-10 text-warning d-inline-flex">
              <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>
            <h6 class="fw-bold mb-2">Apakah Anda yakin ingin menyalakan ulang modem?</h6>
            <p class="small text-muted mb-0">Proses reboot membutuhkan waktu sekitar 1-2 menit. Selama booting
              berlangsung, koneksi internet WiFi Anda akan terputus sementara.</p>
          </div>
          <div class="modal-footer border-0 pt-0 pb-2 px-2 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal"
              style="border-radius:12px;">Batal</button>
            <button type="submit" class="btn btn-warning text-dark fw-bold px-4 flex-grow-1"
              style="border-radius:12px;">Ya, Reboot Sekarang</button>
          </div>
        </form>
      </div>
    </div>
  </div>



  <%- include('partials/customer_bottom_nav', { activeNav: 'home' , isLoggedIn: true }) %>

    <script>
      let currentInvId = null;
      let pModal = null;

      function triggerMairaSupport() {
        window.location.href = '/customer/help';
      }

      function toggleExpandedDock() {
        if (window.innerWidth <= 767) {
          const sheet = document.getElementById('serviceDockBottomSheet');
          const backdrop = document.getElementById('dockSheetBackdrop');
          if (sheet && backdrop) {
            sheet.classList.add('show');
            backdrop.classList.add('show');
          }
        } else {
          const panel = document.getElementById('expandedDockPanel');
          const text = document.getElementById('dockToggleText');
          if (panel) {
            if (panel.style.display === 'none' || panel.style.display === '') {
              panel.style.display = 'grid';
              if (text) text.innerText = 'Sembunyikan';
            } else {
              panel.style.display = 'none';
              if (text) text.innerText = 'Lihat Semua';
            }
          }
        }
      }

      function closeDockBottomSheet() {
        const sheet = document.getElementById('serviceDockBottomSheet');
        const backdrop = document.getElementById('dockSheetBackdrop');
        if (sheet && backdrop) {
          sheet.classList.remove('show');
          backdrop.classList.remove('show');
        }
      }

      function openPaymentModal(invId, amount) {
        currentInvId = invId;
        let num = 0;
        if (typeof amount === 'number') {
          num = isNaN(amount) ? 0 : amount;
        } else if (amount) {
          const clean = String(amount).replace(/[^0-9.]/g, '');
          num = parseFloat(clean) || 0;
        }
        document.getElementById('pay_amount_text').innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
        if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
        pModal.show();
      }

      function submitPayment(method) {
        if (!currentInvId) return;
        window.location.href = `/customer/payment/create/${currentInvId}?method=${method}`;
      }

      function togglePassVisibility() {
        const input = document.getElementById('wifiPassInput');
        const icon = document.getElementById('eyeIcon');
        if (input.type === 'password') {
          input.type = 'text';
          icon.className = 'bi bi-eye-slash';
        } else {
          input.type = 'password';
          icon.className = 'bi bi-eye';
        }
      }

      function openNotifDrawer() {
        if (window._currentNotifKey) {
          try { localStorage.setItem('customer_notifs_read_key', window._currentNotifKey); } catch (e) {}
        }
        const badge = document.getElementById('notifCountBadge');
        if (badge) {
          badge.innerText = '0';
          badge.style.display = 'none';
        }
        const el = document.getElementById('notifDrawerModal');
        if (el && typeof bootstrap !== 'undefined') {
          const modal = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
          modal.show();
        }
      }

      function editSsid(deviceId, currentSsid) {
        document.getElementById('modalSsidInput').value = currentSsid || '';
        const m = new bootstrap.Modal(document.getElementById('editSsidModal'));
        m.show();
      }

      function editPassword(deviceId) {
        document.getElementById('modalPassInput').value = '';
        const m = new bootstrap.Modal(document.getElementById('editPasswordModal'));
        m.show();
      }

      function rebootDevice(deviceId) {
        const m = new bootstrap.Modal(document.getElementById('rebootModal'));
        m.show();
      }

      // LIVE TRAFFIC GAUGES CANVAS
      function drawGauge(canvasId, valueMbps, maxMbps, strokeColor) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const w = canvas.width;
        const h = canvas.height;
        const cx = w / 2;
        const cy = h / 2 + 6;
        const radius = 18;

        ctx.clearRect(0, 0, w, h);

        const startAngle = 0.75 * Math.PI;
        const endAngleTrack = 2.25 * Math.PI;

        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, endAngleTrack, false);
        ctx.lineWidth = 4;
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
        ctx.lineCap = 'round';
        ctx.stroke();

        const val = Math.min(Math.max(0, valueMbps), maxMbps || 10);
        const ratio = (maxMbps > 0) ? (val / maxMbps) : 0;
        const currentAngle = startAngle + ratio * (endAngleTrack - startAngle);

        if (ratio > 0) {
          ctx.beginPath();
          ctx.arc(cx, cy, radius, startAngle, currentAngle, false);
          ctx.lineWidth = 4;
          ctx.strokeStyle = strokeColor || '#ffffff';
          ctx.lineCap = 'round';
          ctx.stroke();
        }

        const needleAngle = currentAngle;
        const needleLen = radius - 3;
        const nx = cx + needleLen * Math.cos(needleAngle);
        const ny = cy + needleLen * Math.sin(needleAngle);

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(nx, ny);
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = '#ffffff';
        ctx.lineCap = 'round';
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, 3, 0, 2 * Math.PI);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      async function fetchTrafficData() {
        try {
          const res = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
          if (!res.ok) return;
          const data = await res.json();

          const rxGauge = document.getElementById('pppoe_rx_gauge');
          const txGauge = document.getElementById('pppoe_tx_gauge');

          const maxDown = parseFloat(rxGauge?.dataset?.max) || 10;
          const maxUp = parseFloat(txGauge?.dataset?.max) || 10;

          const rx = parseFloat(data.rxMbps || data.rx_rate || 0) || 0;
          const tx = parseFloat(data.txMbps || data.tx_rate || 0) || 0;

          const rxValEl = document.getElementById('pppoe_rx_value');
          const rxUnitEl = document.getElementById('pppoe_rx_unit');
          if (rxValEl) rxValEl.innerText = rx < 0.1 ? (rx * 1000).toFixed(0) : rx.toFixed(1);
          if (rxUnitEl) rxUnitEl.innerText = rx < 0.1 ? 'KB' : 'MB';

          const txValEl = document.getElementById('pppoe_tx_value');
          const txUnitEl = document.getElementById('pppoe_tx_unit');
          if (txValEl) txValEl.innerText = tx < 0.1 ? (tx * 1000).toFixed(0) : tx.toFixed(1);
          if (txUnitEl) txUnitEl.innerText = tx < 0.1 ? 'KB' : 'MB';

          drawGauge('pppoe_rx_gauge', rx, maxDown, '#ffffff');
          drawGauge('pppoe_tx_gauge', tx, maxUp, '#ffffff');
        } catch (e) {
          console.error('[Traffic] Fetch error:', e);
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        loadCustomerWebNotifs();
        fetchTrafficData();
        setInterval(fetchTrafficData, 3000);

        const btnPollOnuDock = document.getElementById('btnPollOnuDock');
        if (btnPollOnuDock) {
          btnPollOnuDock.addEventListener('click', async () => {
            btnPollOnuDock.style.opacity = '0.5';
            btnPollOnuDock.style.pointerEvents = 'none';
            try {
              await fetch('/customer/poll-onu', { method: 'POST' });
              location.reload();
            } catch (e) {
              location.reload();
            }
          });
        }

        const btnDeviceRefresh = document.getElementById('btnDeviceRefresh');
        if (btnDeviceRefresh) {
          btnDeviceRefresh.addEventListener('click', async () => {
            btnDeviceRefresh.disabled = true;
            btnDeviceRefresh.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Memeriksa ONU...';
            try {
              const res = await fetch('/api/device/refresh', { method: 'POST' });
              const data = await res.json();
              if (data && data.ok) {
                btnDeviceRefresh.innerHTML = '<i class="bi bi-check-circle text-success"></i> Selesai!';
              } else {
                await fetch('/customer/poll-onu', { method: 'POST' }).catch(() => { });
              }
              setTimeout(() => { location.reload(); }, 1000);
            } catch (e) {
              location.reload();
            }
          });
        }
      });

      function loadCustomerWebNotifs() {
        const container = document.getElementById('notifListContainer');
        if (!container) return;

        const notifs = [];
      <% if (paidInvoices && paidInvoices.length > 0) { %>
        <% paidInvoices.slice(0, 3).forEach(inv => { %>
          <% const pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
            notifs.push({
              id: 'paid-<%= inv.id %>',
              type: 'payment',
              title: 'Pelunasan Tagihan Berhasil',
              message: 'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.',
              time: 'Terkonfirmasi Sistem'
            });
        <% }) %>
      <% } %>

      <% if (hasUnpaid) { %>
        <% const uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price || 0); %>
            notifs.push({
              id: 'unpaid-latest',
              type: 'warning',
              title: 'Pengingat Tagihan Bulanan',
              message: 'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.',
              time: 'Jatuh Tempo Tgl 20'
            });
      <% } %>

        const currentKey = notifs.map(n => n.id).join(',');
        window._currentNotifKey = currentKey;

        let readKey = '';
        try { readKey = localStorage.getItem('customer_notifs_read_key') || ''; } catch (e) {}

        const badge = document.getElementById('notifCountBadge');
        if (badge) {
          if (notifs.length > 0 && readKey !== currentKey) {
            badge.innerText = notifs.length;
            badge.style.display = 'inline-flex';
            badge.style.alignItems = 'center';
            badge.style.justifyContent = 'center';
          } else {
            badge.innerText = '0';
            badge.style.display = 'none';
          }
        }

        if (notifs.length === 0) {
          container.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i><span style="font-size:12px;">Belum ada notifikasi baru</span></div>';
        } else {
          container.innerHTML = notifs.map(n => `
          <div class="p-3 mb-2 rounded-3 text-start" style="background:#e6f2f1; border:1px solid #b2dfdb; border-radius: 14px;">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi bi-${n.type === 'payment' ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-warning'}"></i>
              <span class="fw-bold text-dark" style="font-size: 13px;">${n.title}</span>
            </div>
            <div class="text-muted mb-1" style="font-size: 12px; line-height: 1.4;">${n.message}</div>
            <div class="text-muted fw-semibold" style="font-size: 10px;">${n.time}</div>
          </div>
        `).join('');
        }
      }
    </script>
</body>

</html>

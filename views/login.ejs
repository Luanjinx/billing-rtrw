        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
          <h6 class="fw-extrabold text-dark mb-0 d-flex align-items-center gap-2" style="font-size:16px;">
            <i class="bi bi-credit-card-2-front text-warning fs-5"></i> Pilihan Metode Pembayaran
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:12px;"></button>
        </div>
        <div class="modal-body p-2">
          <div class="text-center mb-4 p-3 rounded-4" style="background:#e6f2f1; border:1px solid #fde68a;">
            <div class="small fw-bold text-muted mb-1">Total Tagihan Harus Dibayar</div>
            <h2 class="fw-extrabold text-warning mb-0" style="font-size:26px;" id="pay_amount_text">Rp 0</h2>
          </div>
          <div class="d-grid gap-3">
            <% if (typeof paymentChannels !=='undefined' && paymentChannels && paymentChannels.length> 0) { %>
              <% paymentChannels.forEach(ch=> { %>
                <button class="btn btn-outline-purple p-3 text-start d-flex align-items-center justify-content-between"
                  onclick="submitPayment('<%= ch.code %>')"
                  style="border-radius:14px; border:1px solid var(--myrep-purple-border); background:#e6f2f1;">
                  <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-qr-code-scan text-primary fs-4"></i>
                    <div>
                      <div class="fw-bold text-dark">
                        <%= ch.name %>
                      </div>
                      <div class="small text-muted">
                        <%= ch.group || 'Metode Pembayaran Online' %>
                      </div>
                    </div>
                  </div>
                  <i class="bi bi-chevron-right text-primary"></i>
                </button>
                <% }) %>
                  <% } else { %>
                    <button class="btn p-3 text-start d-flex align-items-center justify-content-between"
                      onclick="submitPayment('qris')"
                      style="border-radius:16px; border:2px solid var(--myrep-purple-primary); background:#e6f2f1;">
                      <div class="d-flex align-items-center gap-3">
                        <div
                          style="width:44px; height:44px; border-radius:12px; background:var(--myrep-purple-light); display:flex; align-items:center; justify-content:center; color:var(--myrep-purple-primary); font-size:22px;">
                          <i class="bi bi-qr-code-scan"></i>
                        </div>
                        <div>
                          <div class="fw-bold text-dark" style="font-size:15px;">QRIS Instant (Semua E-Wallet)</div>
                          <div class="small text-muted">DANA, GoPay, OVO, ShopeePay, Mobile Banking</div>
                        </div>
                      </div>
                      <i class="bi bi-chevron-right text-primary fs-5"></i>
                    </button>
                    <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="notifDrawerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content p-3 border-0 shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
          <h6 class="modal-title fw-extrabold text-dark mb-0"><i class="bi bi-bell-fill text-warning me-2"></i>Pusat
            Notifikasi</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size: 11px;"></button>
        </div>
        <div class="modal-body px-1 py-2" id="notifListContainer">
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editSsidModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="dock-sheet-handle"></div>
        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
          <h6 class="fw-extrabold text-dark mb-0 d-flex align-items-center gap-2" style="font-size:16px;">
            <i class="bi bi-wifi text-primary fs-5"></i> Ubah Nama WiFi (SSID)
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="font-size:12px;"></button>
        </div>
        <form action="/customer/change-ssid" method="POST">
          <div class="modal-body p-2">
            <div class="mb-3">
              <label class="form-label fw-bold">Nama WiFi (SSID) Baru</label>
              <input type="text" name="ssid" id="modalSsidInput" class="form-control p-3" style="border-radius:12px;"
                required>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0 pb-2 px-2 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal"
              style="border-radius:12px;">Batal</button>
            <button type="submit" class="btn text-white fw-bold px-4 flex-grow-1"
              style="background:var(--myrep-purple-primary); border-radius:12px;">Simpan Nama WiFi</button>
          </div>
        </form>
      </div>

<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= t('customer.dashboard_title', 'Dashboard Pelanggan' ) %> | MyRepublic
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#12504b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
      --myrep-purple-header: linear-gradient(180deg, #12504b 0%, #20756e 65%, #ffffff 100%);
      --myrep-purple-primary: #12504b;
      --myrep-purple-dark: #0e3f3b;
      --myrep-purple-light: #e6f2f1;
      --myrep-purple-border: #b2dfdb;
      --card-border: #b2dfdb;
      --bg-main: #ffffff;
      --card-bg: #ffffff;
      --text-main: #0f2d2a;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    body {
      background: var(--bg-main);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding-bottom: 90px;
      -webkit-tap-highlight-color: transparent;
    }

    /* ── GLOBAL BORDER RADIUS ── */
    .myrep-card,
    .service-dock-card,
    .service-icon-box,
    .speed-monitor-card,
    .info-running-card,
    .info-badge-left,
    .btn-pay-ticker,
    .btn-pay-qris,
    #promoCarousel,
    #promoCarouselContainer,
    #promoCarousel .carousel-inner,
    .promo-slide-img,
    .user-control-strip,
    .user-avatar-circle,
    .btn,
    .badge,
    .stat-box,
    .speed-pill-badge,
    .speed-status-badge,
    .accordion-item,
    .accordion-button,
    .alert,
    .user-control-main,
    .user-control-actions,
    .btn-action-reconnect,
    .btn-action-logout,
    .btn-action-poll,
    .btn-maira,
    .maira-avatar-wrapper,
    .langganan-card,
    .btn-daftar-myrep,
    .dropdown-menu,
    .form-control,
    .form-select,
    .table-responsive {
      border-radius: 12px !important;
    }

    /* ── MYREPUBLIC HEADER ── */
    .myrep-header {
      background: linear-gradient(180deg, #12504b 10%, #42ab91 65%, #ffffff 100%);
      padding: 16px 16px 28px 16px;
      color: #ffffff;
    }

    .top-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.2px;
      margin-bottom: 12px;
      color: rgba(255, 255, 255, 0.9);
    }

    .top-brand-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.3px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      white-space: nowrap;
    }
    .status-pill.online {
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
    }
    .status-pill.suspended {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      position: relative;
    }
    .pulse-dot.green {
      background-color: #10b981;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse-green 2s infinite;
    }
    .pulse-dot.red {
      background-color: #ef4444;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      animation: pulse-red 2s infinite;
    }
    @keyframes pulse-green {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    @keyframes pulse-red {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .myrep-logo-group {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    /* HUBUNGI MAIRA BUTTON */
    .btn-maira {
      background: #ffffff;
      color: var(--myrep-purple-dark);
      border-radius: 14px;
      padding: 5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      cursor: pointer;
      border: none;
    }

    .btn-maira:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
      color: var(--myrep-purple-primary);
    }

    .maira-avatar-wrapper {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e6f2f1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* USER CONTROL STRIP */
    .user-control-strip {
      background: #ffffff;
      border-radius: 18px;
      padding: 14px 18px;
      margin-top: 14px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
      gap: 10px;
      border: 1px solid rgba(178, 223, 219, 0.6);
    }

    .user-control-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .user-control-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
      border-top: 1px solid rgba(178, 223, 219, 0.5);
      padding-top: 8px;
    }

    .user-control-actions-top {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
    }

    .user-control-actions-top form {
      flex: 1;
    }

    .btn-action-reconnect {
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      color: #059669;
      font-weight: 700;
      font-size: 12px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 100%;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-action-reconnect:hover {
      background: #d1fae5;
      color: #047857;
    }

    .btn-action-logout {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
      font-weight: 700;
      font-size: 12px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 100%;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-action-logout:hover {
      background: #fee2e2;
      color: #b91c1c;
    }

    .btn-action-poll {
      background: #e6f2f1;
      border: 1px solid #b2dfdb;
      color: #12504b;
      font-weight: 700;
      font-size: 12px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 100%;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-action-poll:hover {
      background: #b2dfdb;
      color: #0e3f3b;
    }

    /* ── SPEED MONITORING CARD ── */
    .speed-monitor-card {
      background: linear-gradient(135deg, #12504b 0%, #1c6d66 55%, #0c3935 100%);
      border-radius: 20px;
      padding: 16px 20px;
      color: #ffffff;
      box-shadow: 0 10px 28px rgba(18, 80, 75, 0.35);
      border: 1px solid rgba(178, 223, 219, 0.3);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .speed-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .speed-pill-badge {
      background: #ffffff;
      color: #12504b;
      font-weight: 800;
      font-size: 11px;
      padding: 4px 14px;
      border-radius: 12px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .speed-protocol-label {
      font-size: 11px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.7);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .speed-card-divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.12);
      margin: 12px 0;
      width: 100%;
    }

    .speed-card-body {
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 12px;
      padding: 4px 0;
    }

    .speed-stat-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      justify-content: center;
      min-width: 0;
    }

    .speed-gauge-wrapper {
      width: 60px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .speed-stat-info {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .speed-value-text {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.1;
      letter-spacing: -0.3px;
      white-space: nowrap;
    }

    .speed-unit-text {
      font-size: 14px;
      font-weight: 700;
      color: #ffffff;
    }

    .speed-sub-label {
      font-size: 10px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.75);
      letter-spacing: 0.8px;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 4px;
      text-transform: uppercase;
    }

    .speed-arrow-icon {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.85);
    }

    .speed-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .speed-status-badge {
      background: #ffffff;
      color: #16a34a;
      font-weight: 800;
      font-size: 11px;
      padding: 4px 14px;
      border-radius: 12px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .speed-time-label {
      font-size: 11px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 0.3px;
    }

    .user-avatar-circle {
      width: 44px;
      height: 44px;
      min-width: 44px;
      border-radius: 50%;
      background: #12504b;
      border: 1.5px solid #12a498;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 22px;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(18 80 75 / 0.33);
    }

    .user-client-label {
      font-size: 11px;
      font-weight: 700;
      color: #12504b;
      margin-bottom: 2px;
      line-height: 1.1;
    }

    .user-client-phone {
      font-size: 16px;
      font-weight: 800;
      color: #42ab91;
      letter-spacing: -0.2px;
      line-height: 1.2;
    }

    .user-saldo-label {
      font-size: 11px;
      font-weight: 600;
      color: #94a3b8;
      text-align: right;
      margin-bottom: 2px;
      line-height: 1.1;
    }

    .user-saldo-value {
      font-size: 16px;
      font-weight: 800;
      color: #12504b;
      text-align: right;
      line-height: 1.2;
    }

    /* ── 3-COLUMN SERVICE DOCK ── */
    .service-dock-card {
      background: #ffffff;
      border: 2px solid #12504b;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 6px 20px rgba(108, 33, 168, 0.06);
      margin-bottom: 24px;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px 12px;
      padding: 20px 14px;
      text-align: center;
    }

    .service-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      text-decoration: none;
      color: #12504b;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .service-item:hover {
      transform: translateY(-3px);
      color: var(--myrep-purple-primary);
    }

    .service-icon-box {
      width: 58px;
      height: 58px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      position: relative;
      margin-bottom: 2px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      transition: all 0.2s ease;
    }

    .service-item:hover .service-icon-box {
      box-shadow: 0 6px 18px rgba(108, 33, 168, 0.18);
    }

    .service-label {
      font-size: 12px;
      font-weight: 700;
      line-height: 1.3;
      color: #1e293b;
      max-width: 100px;
    }

    /* LIHAT SEMUA BOTTOM BAR */
    .dock-bottom-bar {
      background: #12504b;
      color: #ffffff;
      padding: 12px 16px;
      text-align: center;
      font-size: 14px;
      font-weight: 800;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      user-select: none;
      transition: background 0.2s ease;
    }

    .dock-extra-desktop {
      display: flex;
    }

    .dock-bottom-bar:hover {
      background: #00332f;
    }

    /* ── CUSTOM BOTTOM SHEET FOR SERVICE DOCK ── */
    .dock-bottom-sheet {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100005 !important;
      background: #ffffff;
      border-radius: 28px 28px 0 0 !important;
      padding: 20px 20px calc(30px + env(safe-area-inset-bottom)) 20px;
      box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.25);
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
      visibility: hidden;
      max-height: 85vh;
      overflow-y: auto;
    }

    .dock-bottom-sheet.show {
      transform: translateY(0);
      visibility: visible;
    }

    .dock-sheet-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 100000 !important;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .dock-sheet-backdrop.show {
      opacity: 1;
      visibility: visible;
    }

    .dock-sheet-handle {
      width: 44px;
      height: 5px;
      background: #cbd5e1;
      border-radius: 10px;
      margin: 4px auto 16px auto;
    }

    /* ONT CARD REDESIGN STYLES */
    .status-pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .status-pulse-dot.bg-success {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
      animation: pulseGreen 2s infinite;
    }

    @keyframes pulseGreen {
      0% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
      }

      70% {
        box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
      }
    }

    .btn-edit-action {
      background: #e0e7ff;
      border: 1px solid #c7d2fe;
      color: #4338ca !important;
      font-weight: 700;
      font-size: 11px;
      padding: 3px 10px;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-edit-action:hover {
      background: #c7d2fe;
      color: #3730a3 !important;
      transform: translateY(-1px);
    }

    /* ── PROMO CAROUSEL / SLIDER STYLING (1080x270 Desktop / 480x120 Mobile) ── */
    #promoCarouselContainer {
      max-width: 2080px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    #promoCarousel {
      width: 100%;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(108, 33, 168, 0.12);
      border: 1px solid var(--card-border);
    }

    .promo-slide-img {
      width: 100%;
      aspect-ratio: 1080 / 270;
      object-fit: cover;
      display: block;
      border-radius: 20px;
    }

    .modal-content {
      border-radius: 24px;
      border: none;
    }

    /* ── NOTIFICATION MODAL (TOP POPUP CARD) ── */
    #notifDrawerModal .modal-dialog,
    #notifDrawerModal .modal-dialog.modal-dialog-centered {
      margin: 16px auto !important;
      max-width: 92% !important;
      width: 440px !important;
      align-items: flex-start !important;
      top: 0 !important;
      bottom: auto !important;
    }

    #notifDrawerModal .modal-content {
      border-radius: 20px !important;
      border: 1px solid var(--myrep-purple-border) !important;
      box-shadow: 0 12px 36px rgba(108, 33, 168, 0.2) !important;
      margin-bottom: auto !important;
    }

    /* ── MOBILE BOTTOM SHEET SLIDE-UP ANIMATION FOR OTHER MODALS ── */
    @media (max-width: 767px) {
      #promoCarouselContainer {
        max-width: 480px;
      }

      .promo-slide-img {
        aspect-ratio: 480 / 120;
      }

      .modal:not(#notifDrawerModal) {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      /* Modal Slide Up from Bottom */
      .modal:not(#notifDrawerModal) .modal-dialog,
      .modal:not(#notifDrawerModal) .modal-dialog.modal-dialog-centered {
        position: fixed !important;
        bottom: 0 !important;
        top: auto !important;
        left: 0 !important;
        right: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        height: auto !important;
        min-height: auto !important;
        display: flex !important;
        align-items: flex-end !important;
        transform: translate3d(0, 100%, 0) !important;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
      }

      .modal:not(#notifDrawerModal).show .modal-dialog,
      .modal:not(#notifDrawerModal).show .modal-dialog.modal-dialog-centered {
        transform: translate3d(0, 0, 0) !important;
      }

      /* Modal Sheet Styling with Rounded Top */
      .modal:not(#notifDrawerModal) .modal-content {
        width: 100% !important;
        border-radius: 28px 28px 0 0 !important;
        border: none !important;
        padding: 20px 20px calc(24px + env(safe-area-inset-bottom)) 20px !important;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.25) !important;
        max-height: 85vh;
        overflow-y: auto;
        margin-bottom: 0 !important;
      }

      .modal-backdrop.show {
        backdrop-filter: blur(4px) !important;
        -webkit-backdrop-filter: blur(4px) !important;
        background-color: rgba(15, 23, 42, 0.6) !important;
        opacity: 1 !important;
      }
    }

    /* ── RUNNING INFO HERO CARD ── */
    .info-running-card {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      height: 48px;
      display: flex;
      align-items: center;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.1);
      margin-bottom: 22px;
      position: relative;
    }

    .info-badge-left {
      background: #12504b;
      color: #ffffff;
      height: 100%;
      padding: 0 20px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.5px;
      border-radius: 999px 0 0 999px;
      flex-shrink: 0;
      z-index: 2;

    }

    .info-running-body {
      flex: 1;
      overflow: hidden;
      white-space: nowrap;
      display: flex;
      align-items: center;
      padding: 0 16px;
      color: #1e3a8a;
      font-size: 13px;
      font-weight: 700;
      z-index: 1;
    }

    .info-marquee-text {
      display: inline-block;
      white-space: nowrap;
      animation: marqueeScroll 22s linear infinite;
    }

    .info-running-card:hover .info-marquee-text {
      animation-play-state: paused;
    }

    @keyframes marqueeScroll {
      0% {
        transform: translateX(100%);
      }

      100% {
        transform: translateX(-100%);
      }
    }

    .btn-pay-ticker {
      background: linear-gradient(135deg, #f59e0b, #ea580c);
      color: #ffffff;
      border: none;
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 11px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-right: 8px;
      flex-shrink: 0;
      z-index: 2;
      box-shadow: 0 3px 10px rgba(245, 158, 11, 0.35);
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.2s ease;
    }

    .btn-pay-ticker:hover {
      transform: scale(1.04);
      color: #ffffff;
    }

    .myrep-card {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid rgba(178, 223, 219, 0.7);
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
      margin-bottom: 22px;
      overflow: hidden;
    }

    .myrep-card-header {
      padding: 16px 20px;
      background: #e6f2f1;
      border-bottom: 1px solid var(--myrep-purple-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .myrep-card-header h5 {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
      color: #0f2d2a;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .stat-box {
      background: #e6f2f1;
      border: 1px solid var(--myrep-purple-border);
      border-radius: 14px;
      padding: 12px 8px;
      text-align: center;
    }

    .stat-box .lbl {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
    }

    .stat-box .val {
      font-size: 14px;
      font-weight: 800;
      color: #1e1b4b;
    }

    /* RESPONSIVE DESIGN FOR MOBILE VIEW */
    @media (max-width: 767px) {
      .myrep-header {
        padding: 14px 14px 24px 14px;
      }

      .btn-maira {
        font-size: 12px;
        padding: 5px;
      }

      .service-icon-box {
        width: 44px !important;
        height: 44px !important;
        font-size: 20px !important;
        border-radius: 12px !important;
      }

      .service-grid {
        gap: 12px 6px;
        padding: 12px 4px;
      }

      .service-label {
        font-size: 11px;
        line-height: 1.2;
        font-weight: 700;
      }

      .dock-extra-desktop {
        display: none !important;
      }

      .dock-bottom-bar {
        display: flex !important;
      }

      .info-running-card {
        height: 38px;
        margin-bottom: 14px;
      }

      .info-badge-left {
        padding: 0 10px;
        font-size: 10px;
        gap: 4px;
      }

      .info-running-body {
        font-size: 11px;
        padding: 0 8px;
      }

      .btn-pay-ticker {
        padding: 4px 8px;
        font-size: 9px;
        margin-right: 4px;
      }

      .speed-monitor-card {
        padding: 12px 14px;
      }

      .speed-card-body {
        gap: 4px;
        justify-content: space-between;
      }

      .speed-stat-group {
        gap: 6px;
        min-width: 0;
        flex: 1;
      }

      .speed-gauge-wrapper {
        width: 44px;
        height: 38px;
        flex-shrink: 0;
      }

      .speed-gauge-wrapper canvas {
        width: 44px !important;
        height: 38px !important;
      }

      .speed-value-text {
        font-size: 14px;
        letter-spacing: -0.5px;
      }

      .speed-unit-text {
        font-size: 11px;
      }

      .speed-sub-label {
        font-size: 9px;
        letter-spacing: 0.1px;
        gap: 2px;
      }

      .speed-status-badge {
        padding: 4px 10px;
        font-size: 10px;
      }

      .speed-time-label {
        font-size: 10px;
      }
    }
  </style>
</head>

<body>
  <div class="myrep-header" id="home-section">
    <div class="container p-0">
      <div class="top-brand-bar">
        <a href="/customer/dashboard" class="myrep-logo-group text-decoration-none d-flex align-items-center">
          <img
            src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>"
            alt="Company Logo"
            style="height: 40px; width: auto; max-width: 220px; object-fit: contain; border-radius: 8px;">
        </a>

        <button type="button" class="btn-maira position-relative" onclick="openNotifDrawer()" title="Pusat Notifikasi">
          <div class="maira-avatar-wrapper" style="background:#fef3c7;">
            <i class="bi bi-bell-fill" style="color:#d97706; font-size:14px;"></i>
          </div>
          <span class="notif-badge-count" id="notifCountBadge"
            style="display:none; position:absolute; top:-4px; right:-4px; background:#ef4444; color:#fff; font-size:9px; border-radius:10px; padding:1px 6px; font-weight:800; border:2px solid #ffffff;">0</span>
        </button>
      </div>

      <!-- ── 2 CARDS SIDE-BY-SIDE DI ATAS USER-CONTROL-STRIP ── -->
      <div class="row g-2 mt-2 mb-1">
        <div class="col-6">
          <div style="background:#ffffff; border-radius:16px; padding:12px; box-shadow:0 4px 18px rgba(0,0,0,0.06); border:1px solid rgba(178,223,219,0.6); display:flex; align-items:center; gap:10px; height:100%;">
            <div style="width:36px; height:36px; border-radius:50%; background:#e6f2f1; color:#12504b; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;">
              <i class="bi bi-person-vcard-fill"></i>
            </div>
            <div style="min-width:0; flex:1;">
              <div style="font-size:11px; font-weight:700; color:#64748b; line-height:1.2;">ID Pelanggan</div>
              <div style="font-size:12px; font-weight:800; color:#12504b; text-overflow:ellipsis; overflow:hidden; white-space:nowrap; margin-top:2px;" title="ID: <%= profile ? (profile.genieacs_tag || profile.pppoe_username || profile.phone) : (customer ? customer.phone : '') %>">
                ID: <%= profile ? (profile.genieacs_tag || profile.pppoe_username || profile.phone) : (customer ? customer.phone : '') %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div style="background:#ffffff; border-radius:16px; padding:12px; box-shadow:0 4px 18px rgba(0,0,0,0.06); border:1px solid rgba(178,223,219,0.6); display:flex; align-items:center; gap:10px; height:100%;">
            <div style="width:36px; height:36px; border-radius:50%; background:<%= (typeof profile !== 'undefined' && profile && profile.status === 'active') || customer.status === 'Online' ? '#ecfdf5' : '#fef2f2' %>; color:<%= (typeof profile !== 'undefined' && profile && profile.status === 'active') || customer.status === 'Online' ? '#047857' : '#dc2626' %>; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;">
              <i class="bi <%= (typeof profile !== 'undefined' && profile && profile.status === 'active') || customer.status === 'Online' ? 'bi-wifi' : 'bi-wifi-off' %>"></i>
            </div>
            <div style="min-width:0; flex:1;">
              <div style="font-size:11px; font-weight:700; color:#64748b; line-height:1.2;">Status Layanan</div>
              <div style="font-size:13px; font-weight:800; margin-top:2px; color:<%= (typeof profile !== 'undefined' && profile && profile.status === 'active') || customer.status === 'Online' ? '#059669' : '#dc2626' %>;">
                <%= (typeof profile !== 'undefined' && profile) ? (profile.status === 'active' ? 'Aktif' : 'Isolir') : (customer.status || 'Aktif') %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% 
        const latestInvoice = (typeof invoices !== 'undefined' && invoices && invoices.length > 0) ? invoices[0] : null;
        let invoiceTitle = 'Tagihan';
        let invoiceAmount = 0;
        let invoiceIsPaid = false;
        let invoiceSubText = '';

        if (latestInvoice) {
          const mNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
          const mIndex = Number(latestInvoice.month || (new Date().getMonth() + 1)) - 1;
          const monthStr = (mIndex >= 0 && mIndex < 12) ? mNames[mIndex] : (latestInvoice.month || '');
          const yearStr = latestInvoice.year || new Date().getFullYear();
          invoiceTitle = `Tagihan ${monthStr} ${yearStr}`.trim();
          invoiceAmount = latestInvoice.amount != null ? latestInvoice.amount : (latestInvoice.package_price || 0);
          invoiceIsPaid = (latestInvoice.status === 'paid' || latestInvoice.status === 'PAID');
          
          if (invoiceIsPaid) {
            invoiceSubText = latestInvoice.paid_at ? `Dibayar pada ${formatDateLocal(latestInvoice.paid_at)}` : 'Sudah lunas dibayar';
          } else {
            invoiceSubText = latestInvoice.due_date ? `Jatuh tempo pada ${formatDateLocal(latestInvoice.due_date)}` : 'Belum dilakukan pembayaran';
          }
        } else if (profile) {
          const mNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
          const curMonth = mNames[new Date().getMonth()];
          const curYear = new Date().getFullYear();
          invoiceTitle = `Tagihan ${curMonth} ${curYear}`;
          invoiceAmount = profile.package_price || 0;
          invoiceIsPaid = (profile.status === 'active');
          invoiceSubText = invoiceIsPaid ? 'Status Layanan Aktif' : 'Status Tagihan Pelanggan';
        }
      %>

      <!-- ── CARD TAGIHAN (REDESIGN USER-CONTROL-STRIP) ── -->
      <div style="background:#ffffff; border-radius:20px; padding:18px 20px; box-shadow:0 4px 20px rgba(0,0,0,0.08); border:1px solid rgba(178,223,219,0.6); margin-top:10px;" id="account-section">
        <!-- Top Title & Badge -->
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div style="font-size:13px; font-weight:700; color:#64748b;">
            <%= invoiceTitle %>
          </div>
          <span style="font-size:12px; font-weight:700; padding:4px 12px; border-radius:20px; <%= invoiceIsPaid ? 'background:#ecfdf5; color:#059669;' : 'background:#fef2f2; color:#dc2626;' %>">
            <%= invoiceIsPaid ? 'Sudah dibayar' : 'Belum dibayar' %>
          </span>
        </div>

        <!-- Amount & Chevron Arrow -->
        <div class="d-flex align-items-center justify-content-between my-2">
          <div style="font-size:26px; font-weight:800; color:#12504b; letter-spacing:-0.5px;">
            Rp <%= Number(invoiceAmount || 0).toLocaleString('id-ID') %>
          </div>
          <a href="/customer/transaction" style="color:#0f2d2a; font-size:18px; text-decoration:none; padding:4px;">
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>

        <!-- Subtitle Text -->
        <div style="font-size:12.5px; color:#64748b; margin-bottom:16px; font-weight:500;">
          <%= invoiceSubText %>
        </div>

        <!-- Bottom Action Button -->
        <% if (!invoiceIsPaid) { %>
          <a href="/customer/transaction?action=pay<%= latestInvoice ? '&invoice_id=' + latestInvoice.id + '&amount=' + (latestInvoice.amount != null ? latestInvoice.amount : (latestInvoice.package_price || 0)) : '' %>" class="btn w-100" style="border-radius:12px; font-size:14px; font-weight:800; color:#ffffff; background:#12504b; border:none; padding:11px; box-shadow:0 4px 14px rgba(18, 80, 75, 0.25); transition:all 0.2s ease;">
            <i class="bi bi-qr-code-scan me-1"></i> Bayar Sekarang
          </a>
        <% } else { %>
          <a href="/customer/transaction" class="btn w-100" style="border-radius:12px; font-size:13.5px; font-weight:700; color:#12504b; border:1px solid #cbd5e1; background:#ffffff; padding:10px; transition:all 0.2s ease;">
            Lihat Tagihan
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="container px-3">

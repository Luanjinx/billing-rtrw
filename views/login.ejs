<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= settings.company_header || 'Portal ISP' %> | <%= t('customer.login_title', 'Masuk ke Portal Pelanggan') %></title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#317fe4">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary-teal: #317fe4;
      --primary-dark: #1f5eb1;
      --primary-light: #eff6ff;
      --primary-border: #bfdbfe;
      --accent-green: #10b981;
      --bg-right: #f4f8fb;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      background-color: var(--bg-right);
      color: var(--text-dark);
    }

    .split-container {
      min-height: 100vh;
      display: flex;
      width: 100%;
    }

    /* ── LEFT PANEL (BRAND SIDE) ── */
    .left-panel {
      flex: 1;
      background: linear-gradient(145deg, #317fe4 0%, #1a4f9c 100%);
      color: #ffffff;
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .left-panel::before {
      content: '';
      position: absolute;
      top: -10%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(49, 127, 228, 0) 70%);
      pointer-events: none;
    }

    .brand-header-left {
      display: inline-flex;
      align-items: center;
    }

    .brand-header-left img,
    img[alt="Logo"] {
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      height: 52px !important;
      max-width: 100% !important;
      width: auto !important;
      object-fit: contain !important;
      display: block;
    }

    .brand-header-title {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.3px;
      color: #ffffff;
    }

    .hero-welcome-box {
      max-width: 500px;
      margin: auto 0;
    }

    .hero-welcome-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      margin-bottom: 18px;
      color: #ffffff;
      letter-spacing: -0.8px;
    }

    .hero-welcome-desc {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.82);
      line-height: 1.6;
      margin-bottom: 0;
    }

    /* Testimonial Widget Box */
    .testimonial-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 20px;
      padding: 24px;
      max-width: 480px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .testimonial-headline {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .testimonial-quote {
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.55;
      font-style: italic;
      margin-bottom: 16px;
    }

    .testimonial-user {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .user-avatar-pill {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-weight: 800;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .user-info-name {
      font-size: 0.88rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
    }

    .user-info-role {
      font-size: 0.76rem;
      color: rgba(255, 255, 255, 0.7);
    }

    .rating-stars {
      color: #fbbf24;
      font-size: 0.9rem;
      display: flex;
      gap: 3px;
    }

    /* ── RIGHT PANEL (LIGHT LOGIN SIDE) ── */
    .right-panel {
      flex: 1;
      background-color: var(--bg-right);
      padding: 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .login-form-wrapper {
      width: 100%;
      max-width: 420px;
    }

    .top-progress-pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-bottom: 24px;
    }

    .progress-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--primary-teal);
      transition: all 0.3s ease;
    }

    .progress-dot.small-dot {
      width: 7px;
      height: 7px;
    }

    .progress-dot.active {
      background: var(--primary-teal);
      box-shadow: 0 0 0 3px rgba(49, 127, 228, 0.2);
      animation: pulseGreenDot 2s infinite ease-in-out;
    }

    .progress-dot.inactive {
      background: #cbd5e1;
      opacity: 0.6;
    }

    .progress-bar-segment {
      height: 4px;
      border-radius: 10px;
      transition: all 0.3s ease;
    }

    .progress-bar-segment.active {
      width: 36px;
      background: linear-gradient(90deg, #317fe4 0%, #2563eb 100%);
      position: relative;
      overflow: hidden;
    }

    .progress-bar-segment.active::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
      animation: shimmerPill 2.5s infinite;
    }

    .progress-bar-segment.inactive {
      width: 24px;
      background: #cbd5e1;
      opacity: 0.5;
    }

    @keyframes pulseGreenDot {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(49, 127, 228, 0.4); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(49, 127, 228, 0); }
    }

    @keyframes shimmerPill {
      0% { left: -100%; }
      60%, 100% { left: 100%; }
    }

    .login-main-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--primary-teal);
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    .login-main-subtitle {
      font-size: 0.94rem;
      color: var(--text-muted);
      margin-bottom: 32px;
      line-height: 1.5;
    }

    /* Form Fields */
    .field-label {
      font-size: 0.86rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 8px;
      display: block;
    }

    .custom-input-box {
      width: 100%;
      height: 52px;
      background: #ffffff;
      border: 1.5px solid var(--border-color);
      border-radius: 14px;
      padding: 0 18px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-dark);
      transition: all 0.25s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }

    .custom-input-box:focus {
      outline: none;
      border-color: var(--primary-teal);
      box-shadow: 0 0 0 0.25rem rgba(49, 127, 228, 0.15);
      background: #ffffff;
    }

    .btn-masuk-primary {
      width: 100%;
      height: 52px;
      background: var(--primary-teal);
      border: none;
      border-radius: 14px;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 20px rgba(49, 127, 228, 0.25);
      margin-top: 24px;
    }

    .btn-masuk-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(49, 127, 228, 0.38);
      color: #ffffff;
    }

    /* Quick Action Tools Bar */
    .quick-access-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 28px;
    }

    .quick-access-btn {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 12px 8px;
      text-decoration: none !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-align: center;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .quick-access-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      transform: translateY(-2px);
    }

    .quick-access-icon {
      font-size: 1.25rem;
    }

    .quick-access-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .register-footer-link {
      text-align: center;
      margin-top: 28px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .register-footer-link a {
      color: var(--primary-teal);
      font-weight: 800;
      text-decoration: none;
    }

    .register-footer-link a:hover {
      text-decoration: underline;
    }

    /* PWA Floating Install Button for Mobile/Desktop */
    .top-right-nav-home {
      position: absolute;
      top: 32px;
      right: 40px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* ── RESPONSIVE MOBILE STYLES ── */
    @media (max-width: 991.98px) {
      .left-panel {
        display: none; /* Hide heavy panel on mobile for instant login */
      }
      .right-panel {
        padding: 40px 20px;
        min-height: 100vh;
      }
      .top-right-nav-home {
        top: 20px;
        right: 20px;
      }
      .login-main-title {
        font-size: 1.85rem;
      }
      .quick-access-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>

  <div class="split-container">

    <!-- ── LEFT PANEL (DARK TEAL BRAND SIDE - DESKTOP VIEW) ── -->
    <div class="left-panel">

      <!-- Top Header Brand (Clickable to /customer/home) -->
      <a href="/customer/home" class="brand-header-left text-decoration-none">
        <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
             alt="Logo" style="height: 50px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
      </a>

      <!-- Hero Welcome Message -->
      <div class="hero-welcome-box">
        <h1 class="hero-welcome-title">Welcome Back.</h1>
        <p class="hero-welcome-desc">
          Selamat datang kembali di Portal Resmi <strong><%= settings.company_header %></strong>. Kelola jaringan internet fiber optic Anda dengan cepat, aman, dan mudah.
        </p>
      </div>

      <!-- Testimonial / Quality Guarantee Card -->
      <div class="testimonial-card">
        <div class="testimonial-headline">Guaranteed Quality & Uptime</div>
        <div class="testimonial-quote">
          "Koneksi internet fiber optic super cepat, stabil 24/7 tanpa FUP. Layanan pembayaran tagihan & bantuan CS terintegrasi sangat memudahkan."
        </div>
        <div class="testimonial-user">
          <div class="d-flex align-items-center gap-3">
            <div class="user-avatar-pill">PS</div>
            <div>
              <div class="user-info-name">Pelanggan Setia</div>
              <div class="user-info-role"><%= settings.company_header %> Customer</div>
            </div>
          </div>
          <div class="rating-stars">
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
          </div>
        </div>
      </div>

    </div>

    <!-- ── RIGHT PANEL (LIGHT LOGIN SIDE) ── -->
    <div class="right-panel">



      <!-- Main Login Form Box -->
      <div class="login-form-wrapper">

        <!-- Centered Logo Brand Header (Mobile View Only) -->
        <div class="text-center mb-3 d-lg-none">
          <a href="/customer/home" class="d-inline-flex align-items-center justify-content-center text-decoration-none">
            <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
                 alt="Logo" style="height: 48px; width: auto; max-width: 100%; object-fit: contain; background: transparent; border: none; box-shadow: none;" onerror="this.style.display='none'">
          </a>
        </div>

        <!-- Progress Dots Pill with Animation -->
        <div class="top-progress-pill justify-content-center">
          <div class="progress-dot active"></div>
          <div class="progress-bar-segment active"></div>
          <div class="progress-dot active small-dot"></div>
          <div class="progress-bar-segment active"></div>
          <div class="progress-dot active small-dot"></div>
        </div>

        <!-- Form Title Header -->
        <h2 class="login-main-title">Masuk ke Akun</h2>
        <p class="login-main-subtitle">
          Masukkan ID/Tag Pelanggan atau Nomor WhatsApp Anda untuk melanjutkan
        </p>

        <!-- Form Fields -->
        <form method="POST" action="/customer/login">
          <div class="mb-3">
            <label for="phone" class="field-label">ID / Tag Pelanggan / Nomor WhatsApp</label>
            <input type="text" class="custom-input-box" id="phone" name="phone" 
                   placeholder="Contoh: ID12345 atau 08123456789" required autofocus>
          </div>

          <% if (settings.login_otp_enabled) { %>
            <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-info bg-opacity-15 text-info rounded-3 text-center fw-semibold">
              <i class="bi bi-whatsapp me-1"></i> Kode OTP akan dikirimkan via WhatsApp resmi
            </div>
          <% } %>

          <button type="submit" class="btn-masuk-primary">
            <span>Masuk</span>
            <i class="bi bi-arrow-right fs-5"></i>
          </button>
        </form>

        <% if (error) { %>
          <div class="alert alert-danger mt-3 py-2 px-3 text-center small rounded-3 border-danger border-opacity-25 fw-semibold">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <%= error === 'Nomor HP tidak valid atau belum terdaftar.' ? 'ID/Tag tidak valid atau belum terdaftar.' : error %>
          </div>
        <% } %>

        <!-- Layanan Cepat Shortcuts Grid -->
        <div class="quick-access-grid">
          <a href="/customer/check-billing" class="quick-access-btn">
            <i class="bi bi-receipt text-info quick-access-icon"></i>
            <span class="quick-access-label">Cek Tagihan</span>
          </a>

          <a href="/customer/voucher" class="quick-access-btn">
            <i class="bi bi-ticket-perforated text-warning quick-access-icon"></i>
            <span class="quick-access-label">Beli Voucher</span>
          </a>

          <a href="/customer/register" class="quick-access-btn">
            <i class="bi bi-person-plus text-success quick-access-icon"></i>
            <span class="quick-access-label">Pasang Baru</span>
          </a>

          <% 
            let waClean = String(settings.company_phone || '').replace(/\D/g, '');
            if (waClean.startsWith('0')) waClean = '62' + waClean.slice(1);
          %>
          <a href="<%= waClean ? 'https://wa.me/' + waClean : '#' %>" target="_blank" rel="noopener" class="quick-access-btn">
            <i class="bi bi-whatsapp text-success quick-access-icon"></i>
            <span class="quick-access-label">Bantuan CS</span>
          </a>
        </div>

        <!-- Register Link -->
        <div class="register-footer-link">
          Belum punya akun? <a href="/customer/register">Daftar sekarang</a>
        </div>

      </div>

    </div>

  </div>

  <!-- PWA Install Banner & Modal -->
  <div id="pwa-install-banner" class="position-fixed bottom-0 start-50 translate-middle-x p-3 mb-3" style="z-index: 9999; max-width: 92%; width: 440px; display: none;">
    <div class="card p-3 shadow-2xl border-warning rounded-4 d-flex align-items-center justify-content-between gap-3" style="background: #ffffff;">
      <div class="d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-20 p-2 rounded-3 text-warning border border-warning border-opacity-25 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
          <i class="bi bi-phone-vibrate fs-4"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Install Aplikasi Pelanggan</h6>
          <small class="text-muted" style="font-size:12px">Akses cepat tanpa buka browser!</small>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-warning btn-sm fw-bold px-3 py-2 rounded-3 shadow" onclick="triggerPwaInstall()">
          <i class="bi bi-download me-1"></i> Install
        </button>
        <button type="button" class="btn-close ms-1" onclick="dismissPwaBanner()"></button>
      </div>
    </div>
  </div>

  <div class="modal fade" id="pwaInstallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-dark border border-secondary border-opacity-25 shadow-2xl" style="background: #ffffff; border-radius: 16px;">
        <div class="modal-header border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-download text-warning"></i> Cara Install Aplikasi Pelanggan
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-muted small mb-3">
            Nikmati akses instan ke <strong>Portal Pelanggan <%= settings.company_header %></strong> langsung dari layar utama HP / Komputer Anda!
          </p>

          <div class="p-3 mb-3 rounded-3 border border-secondary border-opacity-25 bg-light">
            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-android2 me-1"></i> Android / Chrome / Laptop (Windows/Mac)</h6>
            <ol class="small text-muted mb-0 ps-3">
              <li class="mb-1">Klik tombol <strong>"Install Sekarang"</strong> di bawah ini.</li>
              <li class="mb-1">Tekan tombol <strong>Install / Tambahkan</strong> pada jendela konfirmasi browser.</li>
              <li>Icon aplikasi <strong>Pelanggan</strong> akan otomatis muncul di Home Screen Anda!</li>
            </ol>
          </div>

          <div class="p-3 rounded-3 border border-secondary border-opacity-25 bg-light">
            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-apple me-1"></i> iPhone / iPad (Safari)</h6>
            <ol class="small text-muted mb-0 ps-3">
              <li class="mb-1">Tekan tombol <strong>Share (Bagikan)</strong> <i class="bi bi-share text-primary"></i> di menu bawah Safari.</li>
              <li class="mb-1">Geser ke bawah dan pilih <strong>"Add to Home Screen" (Tambah ke Layar Utama)</strong> <i class="bi bi-plus-square text-primary"></i>.</li>
              <li>Tekan <strong>Add (Tambah)</strong> di pojok kanan atas.</li>
            </ol>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" id="modal-btn-install-direct" class="btn btn-warning fw-bold px-4 py-2" onclick="triggerPwaInstallDirect()">
            <i class="bi bi-download me-1"></i> Install Sekarang
          </button>
          <button type="button" class="btn btn-outline-secondary px-4 py-2" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let deferredPwaPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      if (!localStorage.getItem('pwa_banner_dismissed')) {
        const banner = document.getElementById('pwa-install-banner');
        if (banner) banner.style.display = 'block';
      }
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
            const modalEl = document.getElementById('pwaInstallModal');
            if (modalEl) {
              const instance = bootstrap.Modal.getInstance(modalEl);
              if (instance) instance.hide();
            }
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }

    window.addEventListener('load', () => {
      const phoneInput = document.getElementById('phone');
      if (phoneInput && !('ontouchstart' in window)) {
        phoneInput.focus();
      }
    });
  </script>
</body>

</html>

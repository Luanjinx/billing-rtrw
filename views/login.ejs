        <% } else { %>
          <% var nClass='alert-' + (notif.type==='danger' ? 'danger' : notif.type==='warning' ? 'warning' :
            notif.type==='info' ? 'info' : 'success' ); %>
            <div class="alert <%= nClass %> alert-dismissible fade show mt-3 shadow-sm" role="alert" id="notif-alert"
              style="border-radius:14px;">
              <i class="bi bi-info-circle me-2"></i>
              <%= notif.text %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>setTimeout(() => { var a = document.getElementById('notif-alert'); if (a) a.classList.remove('show'); }, 4000);</script>
            <% } %>
              <% } %>

                <div id="promoCarouselContainer" class="mb-4" style="display: none;">
                  <div id="promoCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel"
                    data-bs-interval="5000" id="home-section"
                    style="border-radius: 20px; overflow: hidden; box-shadow: 0 8px 24px rgba(108, 33, 168, 0.12); border:1px solid var(--card-border);">
                    <div class="carousel-inner" style="border-radius: 20px; overflow: hidden;">
                    </div>
                  </div>
                </div>
                <script>
                  (function loadPromoSlides() {
                    const container = document.getElementById('promoCarouselContainer');
                    const inner = document.querySelector('#promoCarousel .carousel-inner');
                    if (!container || !inner) return;

                    fetch('/customer/api/promo-slides')
                      .then(r => r.json())
                      .then(slides => {
                        const validSlides = (slides || []).filter(s => s && s.image_path);
                        if (validSlides.length > 0) {
                          inner.innerHTML = validSlides.map((s, i) => `
                <div class="carousel-item ${i === 0 ? 'active' : ''}">
                  <a href="${s.url || '#'}" ${s.open_in_new_tab ? 'target="_blank"' : ''}>
                    <img src="${s.image_path}" alt="${s.title || 'Promo'}" class="promo-slide-img">
                  </a>
                </div>
              `).join('');
                          container.style.display = 'block';
                          if (window.bootstrap && window.bootstrap.Carousel) {
                            const cEl = document.getElementById('promoCarousel');
                            const instance = bootstrap.Carousel.getOrCreateInstance(cEl, { interval: 5000, ride: 'carousel' });
                            instance.to(0);
                            instance.cycle();
                          }
                        } else {
                          container.style.display = 'none';
                        }
                      })
                      .catch(() => {
                        if (container) container.style.display = 'none';
                      });
                  })();
                </script>


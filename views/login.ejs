<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= settings.company_header || 'Portal ISP' %> | <%= t('customer.login_title', 'Portal Login Pelanggan') %></title>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#12504b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --primary: #12504b;
      --primary-dark: #0e3f3b;
      --primary-light: #e6f2f1;
      --primary-border: #b2dfdb;
      --accent: #10b981;
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --border-color: #e2e8f0;
      --text-main: #0f2d2a;
      --text-muted-custom: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-body);
      background-image: 
        radial-gradient(900px 500px at 15% 10%, rgba(18, 80, 75, 0.08) 0%, rgba(248, 250, 252, 0) 60%),
        radial-gradient(800px 450px at 85% 90%, rgba(16, 185, 129, 0.06) 0%, rgba(248, 250, 252, 0) 55%);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      margin: 0;
      -webkit-tap-highlight-color: transparent;
    }

    /* ── HEADER NAVBAR ── */
    .portal-navbar {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      padding: 14px 0;
    }

    .brand-logo-img {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
      animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* ── MAIN CONTAINER ── */
    .portal-main-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px 16px;
    }

    .portal-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 28px;
      box-shadow: 0 16px 50px rgba(18, 80, 75, 0.08);
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .portal-card-header {
      background: linear-gradient(135deg, #12504b 0%, #17635d 100%);
      padding: 30px 24px 26px 24px;
      text-align: center;
      color: #ffffff;
      position: relative;
    }

    .portal-logo-ring {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      border: 2px solid rgba(255, 255, 255, 0.3);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .portal-logo-ring img {
      width: 38px;
      height: 38px;
      object-fit: contain;
    }

    .portal-card-title {
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: 4px;
      color: #ffffff;
    }

    .portal-card-sub {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 0;
    }

    .portal-card-body {
      padding: 28px 24px;
    }

    /* ── FORM ELEMENTS ── */
    .form-floating {
      margin-bottom: 16px;
    }

    .form-control {
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      color: #0f2d2a;
      border-radius: 14px;
      height: 54px;
      padding: 14px 18px;
      font-size: 0.98rem;
      font-weight: 600;
      transition: all 0.25s ease;
    }

    .form-control:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 0.25rem rgba(18, 80, 75, 0.18);
      color: #0f2d2a;
    }

    .form-floating > label {
      color: #64748b;
      font-size: 0.9rem;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
      color: var(--primary);
      font-weight: 700;
    }

    .btn-submit-portal {
      background: linear-gradient(135deg, #12504b 0%, #17635d 100%);
      border: none;
      border-radius: 14px;
      height: 52px;
      font-size: 0.98rem;
      font-weight: 800;
      color: #ffffff;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.3s ease;
      box-shadow: 0 8px 22px rgba(18, 80, 75, 0.25);
      cursor: pointer;
    }

    .btn-submit-portal:hover {
      background: linear-gradient(135deg, #0e3f3b 0%, #12504b 100%);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(18, 80, 75, 0.4);
      color: #ffffff;
    }

    /* ── QUICK TOOLS GRID ── */
    .quick-tools-title {
      font-size: 11.5px;
      font-weight: 800;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 24px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .quick-tools-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #e2e8f0;
    }

    .quick-tools-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .quick-tool-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 12px 14px;
      text-decoration: none !important;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.2s ease;
    }

    .quick-tool-card:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      transform: translateY(-2px);
    }

    .quick-tool-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .quick-tool-title {
      font-size: 12.5px;
      font-weight: 700;
      color: #0f2d2a;
      line-height: 1.2;
    }

    .quick-tool-sub {
      font-size: 10.5px;
      color: #64748b;
      margin-top: 1px;
    }

    /* ── FOOTER ── */
    .portal-footer {
      background: #ffffff;
      border-top: 1px solid var(--border-color);
      padding: 20px 0;
      text-align: center;
      font-size: 0.85rem;
      color: #64748b;
    }

    .footer-secure-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      color: #047857;
      background: #ecfdf5;
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid #a7f3d0;
      margin-bottom: 10px;
    }

    @media (max-width: 575.98px) {
      .portal-card-body {
        padding: 24px 18px;
      }
      .portal-card-header {
        padding: 24px 18px;
      }
      .quick-tools-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- ── HEADER NAVBAR ── -->
  <nav class="portal-navbar">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/customer/home" class="d-flex align-items-center gap-2 text-decoration-none">
        <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
             alt="Logo" class="brand-logo-img" onerror="this.style.display='none'">
        <span class="fw-extrabold fs-5 text-dark"><%= settings.company_header || 'Portal Pelanggan' %></span>
      </a>

      <div class="d-flex align-items-center gap-2">
        <a href="/customer/home" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold text-decoration-none me-1 d-none d-sm-inline-flex">
          <i class="bi bi-house-door me-1"></i> Beranda
        </a>
        <div class="status-pill d-none d-md-inline-flex">
          <span class="status-dot"></span> Sistem Online
        </div>
        <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 py-1.5 fw-bold shadow-sm" onclick="triggerPwaInstall()">
          <i class="bi bi-download me-1"></i> Install App
        </button>
      </div>
    </div>
  </nav>

  <!-- ── MAIN LOGIN PORTAL ── -->
  <div class="portal-main-wrapper">
    <div class="portal-card">

      <!-- Header Card -->
      <div class="portal-card-header">
        <div class="portal-logo-ring">
          <img src="/img/logo.png?v=<%= (typeof settings !== 'undefined' && settings.logo_updated_at) ? settings.logo_updated_at : Date.now() %>" 
               alt="Logo" onerror="this.src='/favicon.ico'; this.onerror=null;">
        </div>
        <h1 class="portal-card-title"><%= t('customer.portal_title', 'Portal Pelanggan') %></h1>
        <p class="portal-card-sub"><%= settings.company_header %> • Layanan Internet Fiber</p>
      </div>

      <!-- Body Card -->
      <div class="portal-card-body">
        <form method="POST" action="/customer/login">
          <div class="form-floating">
            <input type="text" class="form-control" id="phone" name="phone" 
                   placeholder="<%= t('customer.id_tag_placeholder', 'Masukkan ID/Tag Pelanggan') %>" required autofocus>
            <label for="phone">
              <i class="bi bi-person-badge me-2"></i>ID / Tag Pelanggan / No. HP
            </label>
          </div>

          <div class="text-center mb-3 small text-muted">
            <i class="bi bi-info-circle me-1"></i> Masukkan ID pelanggan atau Nomor WhatsApp terdaftar
          </div>

          <% if (settings.login_otp_enabled) { %>
            <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-info bg-opacity-15 text-info rounded-3 text-center fw-semibold">
              <i class="bi bi-whatsapp me-1"></i> <%= t('customer.otp_sent_via_wa', 'Kode OTP akan dikirim via WhatsApp') %>
            </div>
          <% } %>

          <button type="submit" class="btn btn-submit-portal">
            <span><%= t('customer.sign_in', 'Masuk Ke Portal Pelanggan') %></span>
            <i class="bi bi-arrow-right fs-5"></i>
          </button>
        </form>

        <% if (error) { %>
          <div class="alert alert-danger mt-3 py-2 px-3 text-center small rounded-3 border-danger border-opacity-25 fw-semibold">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <%= error === 'Nomor HP tidak valid atau belum terdaftar.' ? 'ID/Tag tidak valid atau belum terdaftar.' : error %>
          </div>
        <% } %>

        <!-- Layanan Cepat Grid -->
        <div class="quick-tools-title">Layanan Cepat Pelanggan</div>
        <div class="quick-tools-grid">
          <a href="/customer/check-billing" class="quick-tool-card">
            <div class="quick-tool-icon" style="background:#e0f2fe; color:#0284c7;">
              <i class="bi bi-receipt"></i>
            </div>
            <div>
              <div class="quick-tool-title">Cek Tagihan</div>
              <div class="quick-tool-sub">Status bayar</div>
            </div>
          </a>

          <a href="/customer/voucher" class="quick-tool-card">
            <div class="quick-tool-icon" style="background:#fef3c7; color:#d97706;">
              <i class="bi bi-ticket-perforated"></i>
            </div>
            <div>
              <div class="quick-tool-title">Beli Voucher</div>
              <div class="quick-tool-sub">Wi-Fi Hotspot</div>
            </div>
          </a>

          <a href="/customer/register" class="quick-tool-card">
            <div class="quick-tool-icon" style="background:#ecfdf5; color:#059669;">
              <i class="bi bi-person-plus"></i>
            </div>
            <div>
              <div class="quick-tool-title">Pasang Baru</div>
              <div class="quick-tool-sub">Daftar jaringan</div>
            </div>
          </a>

          <% 
            let waClean = String(settings.company_phone || '').replace(/\D/g, '');
            if (waClean.startsWith('0')) waClean = '62' + waClean.slice(1);
          %>
          <a href="<%= waClean ? 'https://wa.me/' + waClean : '#' %>" target="_blank" rel="noopener" class="quick-tool-card">
            <div class="quick-tool-icon" style="background:#e6f2f1; color:#12504b;">
              <i class="bi bi-headset"></i>
            </div>
            <div>
              <div class="quick-tool-title">Bantuan CS</div>
              <div class="quick-tool-sub">Live Chat WA</div>
            </div>
          </a>
        </div>

        <div class="text-center mt-4 pt-3 border-top">
          <p class="mb-0 small text-muted">
            <%= t('customer.not_subscribed', 'Belum berlangganan?') %>
            <a href="/customer/register" class="fw-bold text-decoration-none ms-1" style="color: #12504b;">
              <%= t('customer.register_new', 'Daftar Pemasangan Baru') %> <i class="bi bi-arrow-right"></i>
            </a>
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- ── FOOTER ── -->
  <footer class="portal-footer">
    <div class="container">
      <div class="footer-secure-badge">
        <i class="bi bi-shield-lock-fill"></i> Sesi Login Aman (SSL 256-Bit Encrypted)
      </div>
      <div>
        &copy; <%= new Date().getFullYear() %> <strong><%= settings.company_header %></strong>. All rights reserved.
      </div>
      <div class="small text-muted mt-1">
        <a href="/customer/home" class="text-muted text-decoration-none me-2">Beranda</a> • 
        <a href="/customer/tos" class="text-muted text-decoration-none me-2 ms-2">Syarat & Ketentuan</a> • 
        <a href="/customer/privacy" class="text-muted text-decoration-none ms-2">Kebijakan Privasi</a>
      </div>
    </div>
  </footer>

  <!-- Floating PWA Install Banner -->
  <div id="pwa-install-banner" class="position-fixed bottom-0 start-50 translate-middle-x p-3 mb-3" style="z-index: 9999; max-width: 92%; width: 440px; display: none;">
    <div class="card p-3 shadow-2xl border-warning rounded-4 d-flex align-items-center justify-content-between gap-3" style="background: #ffffff;">
      <div class="d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-20 p-2 rounded-3 text-warning border border-warning border-opacity-25 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
          <i class="bi bi-phone-vibrate fs-4"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Install Aplikasi Pelanggan</h6>
          <small class="text-muted" style="font-size:12px">Akses instan tanpa buka browser tiap kali login!</small>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-warning btn-sm fw-bold px-3 py-2 rounded-3 shadow" onclick="triggerPwaInstall()">
          <i class="bi bi-download me-1"></i> Install
        </button>
        <button type="button" class="btn-close ms-1" onclick="dismissPwaBanner()"></button>
      </div>
    </div>
  </div>

  <!-- PWA Install Modal -->
  <div class="modal fade" id="pwaInstallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-dark border border-secondary border-opacity-25 shadow-2xl" style="background: #ffffff; border-radius: 16px;">
        <div class="modal-header border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-download text-warning"></i> Cara Install Aplikasi Pelanggan
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-muted small mb-3">
            Nikmati akses instan ke <strong>Portal Pelanggan <%= settings.company_header %></strong> langsung dari layar utama HP / Komputer Anda!
          </p>

          <div class="p-3 mb-3 rounded-3 border border-secondary border-opacity-25 bg-light">
            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-android2 me-1"></i> Android / Chrome / Laptop (Windows/Mac)</h6>
            <ol class="small text-muted mb-0 ps-3">
              <li class="mb-1">Klik tombol <strong>"Install Sekarang"</strong> di bawah ini.</li>
              <li class="mb-1">Tekan tombol <strong>Install / Tambahkan</strong> pada jendela konfirmasi browser.</li>
              <li>Icon aplikasi <strong>Pelanggan</strong> akan otomatis muncul di Home Screen Anda!</li>
            </ol>
          </div>

          <div class="p-3 rounded-3 border border-secondary border-opacity-25 bg-light">
            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-apple me-1"></i> iPhone / iPad (Safari)</h6>
            <ol class="small text-muted mb-0 ps-3">
              <li class="mb-1">Tekan tombol <strong>Share (Bagikan)</strong> <i class="bi bi-share text-primary"></i> di menu bawah Safari.</li>
              <li class="mb-1">Geser ke bawah dan pilih <strong>"Add to Home Screen" (Tambah ke Layar Utama)</strong> <i class="bi bi-plus-square text-primary"></i>.</li>
              <li>Tekan <strong>Add (Tambah)</strong> di pojok kanan atas.</li>
            </ol>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" id="modal-btn-install-direct" class="btn btn-warning fw-bold px-4 py-2" onclick="triggerPwaInstallDirect()">
            <i class="bi bi-download me-1"></i> Install Sekarang
          </button>
          <button type="button" class="btn btn-outline-secondary px-4 py-2" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let deferredPwaPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      if (!localStorage.getItem('pwa_banner_dismissed')) {
        const banner = document.getElementById('pwa-install-banner');
        if (banner) banner.style.display = 'block';
      }
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
            const modalEl = document.getElementById('pwaInstallModal');
            if (modalEl) {
              const instance = bootstrap.Modal.getInstance(modalEl);
              if (instance) instance.hide();
            }
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }

    window.addEventListener('load', () => {
      const phoneInput = document.getElementById('phone');
      if (phoneInput && !('ontouchstart' in window)) {
        phoneInput.focus();
      }
    });
  </script>
</body>

</html>
